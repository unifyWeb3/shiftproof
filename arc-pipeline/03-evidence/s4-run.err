{"kind":"data","event":{"type":"file_write_streaming","toolCallId":"01a17b41-d665-742c-8f87-e43f8a6a5e39","path":"/home/user/fork-tests/shiftproof-e2e.ts","status":"running","chunk":"  // MockUSDC mint ABI\n  const MOCK_USDC_ABI = [\n    ...ERC20_ABI,\n    { type: \"function\", name: \"mint\", inputs: [{ name: \"to\", type: \"address\" }, { name: \"amount\", type: \"uint256\" }], outputs: [], stateMutability: \"nonpayable\" },\n  ] as const;\n\n  // Helper: read USDC balance\n  async function usdcBal(addr: Address): Promise<bigint> {\n    return pub.readContract({ address: USDC_ADDR, abi: ERC20_ABI, functionName: \"balanceOf\", args: [addr] });\n  }\n\n  // Helper: mint USDC to address\n  async function mintUsdc(to: Address, amount: bigint) {\n    const data = encodeFunctionData({ abi: MOCK_USDC_ABI, functionName: \"mint\", args: [to, amount] });\n    return sendTx(DEPLOYER, USDC_ADDR, data, \"mint\");\n  }\n\n  // Helper: approve USDC for contract\n  async function approveUsdc(from: Address, amount: bigint) {\n    const data = encodeFunctionData({ abi: ERC20_ABI, functionName: \"approve\", args: [CONTRACT, amount] });\n    return sendTx(from, USDC_ADDR, data, `approve(${from.slice(0,8)})`);\n  }","oldContent":"  // Helper: read USDC balance\n  async function usdcBal(addr: Address): Promise<bigint> {\n    return pub.readContract({ address: USDC_ADDR, abi: ERC20_ABI, functionName: \"balanceOf\", args: [addr] });\n  }\n\n  // Helper: approve USDC for contract\n  async function approveUsdc(from: Address, amount: bigint) {\n    const data = encodeFunctionData({ abi: ERC20_ABI, functionName: \"approve\", args: [CONTRACT, amount] });\n    return sendTx(from, USDC_ADDR, data, \"approve\");\n  }","totalLines":22,"oldTotalLines":10}}
