{"kind":"data","event":{"type":"file_write_streaming","toolCallId":"01a17b40-ab28-77c9-8867-ce9e05a65b73","path":"/home/user/fork-tests/shiftproof-e2e.ts","status":"running","chunk":"/**\n * ShiftProof V1 — Arc Testnet Fork E2E\n *\n * Forks Arc Testnet at the tip, impersonates funded employer/worker\n * wallets, and exercises three flows against the already-deployed\n * contract at 0x39845ad25394ec0a6c15ebc5d8968d9c70bb41a6.\n *\n * No private keys are used. All senders are obtained via\n * anvil_impersonateAccount + anvil_setBalance.\n * USDC balances are funded by writing the ERC-20 balance storage slot.\n *\n * Run:  bun run fork-tests/shiftproof-e2e.ts\n */\n\nimport { createPublicClient, createWalletClient, http, parseUnits,\n         formatUnits, encodeFunctionData, getAddress, keccak256,\n         encodeAbiParameters, parseAbiParameters, pad, toHex,\n         type Address, type Hex } from \"viem\";\nimport { privateKeyToAccount } from \"viem/accounts\";\nimport { arcTestnet } from \"viem/chains\";\nimport { readFileSync, writeFileSync, mkdirSync } from \"fs\";\nimport { execSync } from \"child_process\";\nimport { dirname } from \"path\";\n\n// ---------------------------------------------------------------------------\n// Constants\n// ---------------------------------------------------------------------------\n\nconst CONTRACT   = \"0x39845ad25394ec0a6c15ebc5d8968d9c70bb41a6\" as Address;\nconst USDC_ADDR  = \"0x3600000000000000000000000000000000000000\" as Address;\nconst CHAIN_ID   = 5042002;\nconst FORK_RPC   = \"https://rpc.testnet.arc.io\";\nconst ANVIL_PORT = 8545;\nconst ANVIL_RPC  = `http://127.0.0.1:${ANVIL_PORT}`;\n\n// Deterministic test addresses (no private keys needed — impersonated)\nconst EMPLOYER = \"0x1111111111111111111111111111111111111111\" as Address;\nconst WORKER   = \"0x2222222222222222222222222222222222222222\" as Address;\nconst THIRD    = \"0x3333333333333333333333333333333333333333\" as Address;\n\n// USDC amounts (6-decimal)\nconst USDC_6 = (n: number) => BigInt(Math.round(n * 1e6));\n\n// ---------------------------------------------------------------------------\n// ShiftProof ABI (minimal — only what E2E calls)\n// ---------------------------------------------------------------------------\n\nconst ABI = [\n  // state-changing\n  {\n    type: \"function\", name: \"createShift\",\n    inputs: [\n      { name: \"worker\",     type: \"address\" },\n      { name: \"hourlyRate\", type: \"uint256\" },\n      { name: \"maxSeconds\", type: \"uint32\"  },\n    ],\n    outputs: [{ name: \"shiftId\", type: \"uint256\" }],\n    stateMutability: \"nonpayable\",\n  },\n  { type: \"function\", name: \"clockIn\",    inputs: [{ name: \"shiftId\", type: \"uint256\" }], outputs: [], stateMutability: \"nonpayable\" },\n  { type: \"function\", name: \"clockOut\",   inputs: [{ name: \"shiftId\", type: \"uint256\" }], outputs: [], stateMutability: \"nonpayable\" },\n  {\n    type: \"function\", name: \"attest\",\n    inputs: [{ name: \"shiftId\", type: \"uint256\" }, { name: \"attestedSeconds\", type: \"uint32\" }],\n    outputs: [],\n    stateMutability: \"nonpayable\",\n  },\n  { type: \"function\", name: \"claim\",       inputs: [{ name: \"shiftId\", type: \"uint256\" }], outputs: [], stateMutability: \"nonpayable\" },\n  { type: \"function\", name: \"refundUnused\",inputs: [{ name: \"shiftId\", type: \"uint256\" }], outputs: [], stateMutability: \"nonpayable\" },\n  { type: \"function\", name: \"cancel\",      inputs: [{ name: \"shiftId\", type: \"uint256\" }], outputs: [], stateMutability: \"nonpayable\" },\n  // views\n  {\n    type: \"function\", name: \"getShift\",\n    inputs: [{ name: \"shiftId\", type: \"uint256\" }],\n    outputs: [{\n      name: \"\", type: \"tuple\",\n      components: [\n        { name: \"employer\",        type: \"address\" },\n        { name: \"worker\",          type: \"address\" },\n        { name: \"createdAt\",       type: \"uint64\"  },\n        { name: \"startedAt\",       type: \"uint64\"  },\n        { name: \"endedAt\",         type: \"uint64\"  },\n        { name: \"maxSeconds\",      type: \"uint32\"  },\n        { name: \"attestedSeconds\", type: \"uint32\"  },\n        { name: \"hourlyRate\",      type: \"uint256\" },\n        { name: \"escrow\",          type: \"uint256\" },\n        { name: \"owed\",            type: \"uint256\" },\n        { name: \"status\",          type: \"uint8\"   },\n      ],\n    }],\n    stateMutability: \"view\",\n  },\n  { type: \"function\", name: \"totalEscrow\",  inputs: [], outputs: [{ type: \"uint256\" }], stateMutability: \"view\" },\n  { type: \"function\", name: \"nextShiftId\",  inputs: [], outputs: [{ type: \"uint256\" }], stateMutability: \"view\" },\n] as const;\n\n// ERC-20 minimal ABI\nconst ERC20_ABI = [\n  { type: \"function\", name: \"approve\",     inputs: [{ name: \"spender\", type: \"address\" }, { name: \"amount\", type: \"uint256\" }], outputs: [{ type: \"bool\" }], stateMutability: \"nonpayable\" },\n  { type: \"function\", name: \"balanceOf\",   inputs: [{ name: \"account\", type: \"address\" }], outputs: [{ type: \"uint256\" }], stateMutability: \"view\" },\n  { type: \"function\", name: \"allowance\",   inputs: [{ name: \"owner\", type: \"address\" }, { name: \"spender\", type: \"address\" }], outputs: [{ type: \"uint256\" }], stateMutability: \"view\" },\n] as const;\n\nconst STATUS_NAME = [\"None\",\"Funded\",\"Active\",\"AwaitingAttestation\",\"Attested\",\"Claimed\",\"Settled\",\"Cancelled\"];\n\n// ---------------------------------------------------------------------------\n// Anvil JSON-RPC helper\n// ---------------------------------------------------------------------------\n\nasync function rpc(method: string, params: unknown[] = []): Promise<unknown> {\n  const res = await fetch(ANVIL_RPC, {\n    method: \"POST\",\n    headers: { \"content-type\": \"application/json\" },\n    body: JSON.stringify({ jsonrpc: \"2.0\", id: 1, method, params }),\n  });\n  const j = await res.json() as { result?: unknown; error?: { message: string } };\n  if (j.error) throw new Error(`RPC ${method}: ${j.error.message}`);\n  return j.result;\n}\n\n// ---------------------------------------------------------------------------\n// Fund helpers\n// ---------------------------------------------------------------------------\n\n// Give an address native gas (18-decimal USDC on Arc, used for gas)\nasync function giveGas(addr: Address, ethAmount = 10n ** 18n * 100n) {\n  await rpc(\"anvil_setBalance\", [addr, toHex(ethAmount)]);\n}\n\n// Write USDC ERC-20 balance by overwriting storage slot.\n// Arc USDC is a standard OpenZeppelin ERC-20; balances live at slot\n//   keccak256(abi.encode(account, 0))  — mapping at slot 0\nasync function giveUsdc(addr: Address, amount: bigint) {\n  // ERC-20 balanceOf mapping is at storage slot 0 (standard OZ layout)\n  const slot = keccak256(\n    encodeAbiParameters(\n      parseAbiParameters(\"address, uint256\"),\n      [addr, 0n]\n    )\n  );\n  await rpc(\"anvil_setStorageAt\", [USDC_ADDR, slot, pad(toHex(amount), { size: 32 })]);\n}\n\n// Impersonate a sender so we can send txs from it on the fork\nasync function impersonate(addr: Address) {\n  await rpc(\"anvil_impersonateAccount\", [addr]);\n}\n\n// ---------------------------------------------------------------------------\n// Transaction sender (impersonated — no private key)\n// ---------------------------------------------------------------------------\n\nasync function sendTx(\n  from: Address,\n  to: Address,\n  data: Hex,\n  label: string\n): Promise<{ hash: Hex; block: bigint; gasUsed: bigint }> {\n  const hash = await rpc(\"eth_sendTransaction\", [{ from, to, data, gas: \"0x7A120\" }]) as Hex;\n  // Wait for receipt\n  let receipt: Record<string, unknown> | null = null;\n  for (let i = 0; i < 30; i++) {\n    receipt = await rpc(\"eth_getTransactionReceipt\", [hash]) as Record<string, unknown> | null;\n    if (receipt) break;\n    await new Promise(r => setTimeout(r, 200));\n  }\n  if (!receipt) throw new Error(`${label}: receipt not found for ${hash}`);\n  if (receipt.status !== \"0x1\") {\n    throw new Error(`${label}: tx REVERTED hash=${hash} status=${receipt.status}`);\n  }\n  return {\n    hash,\n    block: BigInt(receipt.blockNumber as string),\n    gasUsed: BigInt(receipt.gasUsed as string),\n  };\n}\n\n// ---------------------------------------------------------------------------\n// Viem read client on the fork\n// ---------------------------------------------------------------------------\n\nfunction makePublicClient() {\n  return createPublicClient({\n    transport: http(ANVIL_RPC),\n  });\n}\n\n// ---------------------------------------------------------------------------\n// Result collector\n// ---------------------------------------------------------------------------\n\ninterface FlowResult {\n  name: string;\n  passed: boolean;\n  failure?: string;\n  shiftId?: number;\n  txs: Array<{ step: string; hash: string; block: number; gasUsed: number }>;\n  finalStatus?: string;\n  finalEscrow?: string;\n  workerBalanceDelta?: string;\n  employerBalanceDelta?: string;\n}\n\nconst results: FlowResult[] = [];\n\n// ---------------------------------------------------------------------------\n// Main\n// ---------------------------------------------------------------------------\n\nasync function main() {\n  console.log(\"=== ShiftProof Arc Testnet Fork E2E ===\");\n  console.log(`Contract : ${CONTRACT}`);\n  console.log(`USDC     : ${USDC_ADDR}`);\n  console.log(`Chain ID : ${CHAIN_ID}`);\n  console.log(`Employer : ${EMPLOYER}`);\n  console.log(`Worker   : ${WORKER}`);\n  console.log(`Third    : ${THIRD}`);\n  console.log();\n\n  // Setup: impersonate accounts and fund with gas + USDC\n  await impersonate(EMPLOYER);\n  await impersonate(WORKER);\n  await impersonate(THIRD);\n  await giveGas(EMPLOYER);\n  await giveGas(WORKER);\n  await giveGas(THIRD);\n\n  // Give employer plenty of USDC (100 USDC to cover all three flows)\n  const EMPLOYER_USDC_START = USDC_6(100);\n  await giveUsdc(EMPLOYER, EMPLOYER_USDC_START);\n\n  const pub = makePublicClient();\n\n  // Helper: read USDC balance\n  async function usdcBal(addr: Address): Promise<bigint> {\n    return pub.readContract({ address: USDC_ADDR, abi: ERC20_ABI, functionName: \"balanceOf\", args: [addr] });\n  }\n\n  // Helper: approve USDC for contract\n  async function approveUsdc(from: Address, amount: bigint) {\n    const data = encodeFunctionData({ abi: ERC20_ABI, functionName: \"approve\", args: [CONTRACT, amount] });\n    return sendTx(from, USDC_ADDR, data, \"approve\");\n  }\n\n  // Helper: read shift\n  async function readShift(id: bigint) {\n    return pub.readContract({ address: CONTRACT, abi: ABI, functionName: \"getShift\", args: [id] });\n  }\n\n  // Helper: read totalEscrow\n  async function totalEscrow(): Promise<bigint> {\n    return pub.readContract({ address: CONTRACT, abi: ABI, functionName: \"totalEscrow\" });\n  }\n\n  // Approve max once for employer\n  await approveUsdc(EMPLOYER, 2n ** 256n - 1n);\n\n  // =========================================================================\n  // FLOW 1 — Happy path: create 2h@5, clockIn, clockOut, attest 5400s, claim, refundUnused\n  // =========================================================================\n  {\n    const flow: FlowResult = { name: \"Flow 1: Happy path\", passed: false, txs: [] };\n    console.log(\"--- Flow 1: Happy path ---\");\n    try {\n      const escrowBefore = await totalEscrow();\n      const employerBefore = await usdcBal(EMPLOYER);\n      const workerBefore   = await usdcBal(WORKER);\n\n      // hourlyRate = 5 USDC/h = 5_000_000 units; maxSeconds = 7200 (2h)\n      // escrow = 5_000_000 * 7200 / 3600 = 10_000_000 (10 USDC)\n      const RATE     = USDC_6(5);  // 5_000_000\n      const DUR      = 7200;       // 2h\n      const ATTEST_S = 5400;       // 1.5h\n      // owed = 5_000_000 * 5400 / 3600 = 7_500_000 (7.5 USDC)\n      const OWED   = USDC_6(7.5);\n      const ESCROW = USDC_6(10);\n      const REFUND = ESCROW - OWED; // 2.5 USDC\n\n      // createShift\n      const createData = encodeFunctionData({ abi: ABI, functionName: \"createShift\", args: [WORKER, RATE, DUR] });\n      const t1 = await sendTx(EMPLOYER, CONTRACT, createData, \"createShift\");\n      flow.txs.push({ step: \"createShift\", hash: t1.hash, block: Number(t1.block), gasUsed: Number(t1.gasUsed) });\n      console.log(`  createShift  tx=${t1.hash} block=${t1.block}`);\n\n      // Read shift ID\n      const nextId = await pub.readContract({ address: CONTRACT, abi: ABI, functionName: \"nextShiftId\" });\n      const shiftId = nextId - 1n;\n      flow.shiftId = Number(shiftId);\n      console.log(`  shiftId=${shiftId}`);\n\n      // Verify escrow funded\n      const s1 = await readShift(shiftId);\n      if (s1.status !== 1) throw new Error(`Expected Funded(1) got ${s1.status}`);\n      if (s1.escrow !== ESCROW) throw new Error(`escrow mismatch: got ${s1.escrow} want ${ESCROW}`);\n      console.log(`  state=Funded escrow=${formatUnits(s1.escrow, 6)} USDC`);\n\n      // clockIn\n      const clockInData = encodeFunctionData({ abi: ABI, functionName: \"clockIn\", args: [shiftId] });\n      const t2 = await sendTx(WORKER, CONTRACT, clockInData, \"clockIn\");\n      flow.txs.push({ step: \"clockIn\", hash: t2.hash, block: Number(t2.block), gasUsed: Number(t2.gasUsed) });\n      console.log(`  clockIn      tx=${t2.hash} block=${t2.block}`);\n      const s2 = await readShift(shiftId);\n      if (s2.status !== 2) throw new Error(`Expected Active(2) got ${s2.status}`);\n      console.log(`  state=Active startedAt=${s2.startedAt}`);\n\n      // clockOut\n      const clockOutData = encodeFunctionData({ abi: ABI, functionName: \"clockOut\", args: [shiftId] });\n      const t3 = await sendTx(WORKER, CONTRACT, clockOutData, \"clockOut\");\n      flow.txs.push({ step: \"clockOut\", hash: t3.hash, block: Number(t3.block), gasUsed: Number(t3.gasUsed) });\n      console.log(`  clockOut     tx=${t3.hash} block=${t3.block}`);\n      const s3 = await readShift(shiftId);\n      if (s3.status !== 3) throw new Error(`Expected AwaitingAttestation(3) got ${s3.status}`);\n      console.log(`  state=AwaitingAttestation endedAt=${s3.endedAt}`);\n\n      // attest 5400s\n      const attestData = encodeFunctionData({ abi: ABI, functionName: \"attest\", args: [shiftId, ATTEST_S] });\n      const t4 = await sendTx(EMPLOYER, CONTRACT, attestData, \"attest\");\n      flow.txs.push({ step: \"attest(5400s)\", hash: t4.hash, block: Number(t4.block), gasUsed: Number(t4.gasUsed) });\n      console.log(`  attest(5400) tx=${t4.hash} block=${t4.block}`);\n      const s4 = await readShift(shiftId);\n      if (s4.status !== 4) throw new Error(`Expected Attested(4) got ${s4.status}`);\n      if (s4.owed !== OWED) throw new Error(`owed mismatch: got ${s4.owed} want ${OWED}`);\n      console.log(`  state=Attested owed=${formatUnits(s4.owed, 6)} USDC`);\n\n      // claim\n      const claimData = encodeFunctionData({ abi: ABI, functionName: \"claim\", args: [shiftId] });\n      const t5 = await sendTx(WORKER, CONTRACT, claimData, \"claim\");\n      flow.txs.push({ step: \"claim\", hash: t5.hash, block: Number(t5.block), gasUsed: Number(t5.gasUsed) });\n      console.log(`  claim        tx=${t5.hash} block=${t5.block}`);\n      const s5 = await readShift(shiftId);\n      if (s5.status !== 5) throw new Error(`Expected Claimed(5) got ${s5.status}`);\n      if (s5.owed !== 0n) throw new Error(`owed not zero after claim`);\n      console.log(`  state=Claimed owed=0 escrow=${formatUnits(s5.escrow, 6)} USDC`);\n\n      // refundUnused (called by THIRD)\n      const refundData = encodeFunctionData({ abi: ABI, functionName: \"refundUnused\", args: [shiftId] });\n      const t6 = await sendTx(THIRD, CONTRACT, refundData, \"refundUnused\");\n      flow.txs.push({ step: \"refundUnused\", hash: t6.hash, block: Number(t6.block), gasUsed: Number(t6.gasUsed) });\n      console.log(`  refundUnused tx=${t6.hash} block=${t6.block}`);\n      const s6 = await readShift(shiftId);\n      if (s6.status !== 6) throw new Error(`Expected Settled(6) got ${s6.status}`);\n      if (s6.escrow !== 0n) throw new Error(`escrow not zero after refund`);\n      console.log(`  state=Settled escrow=0`);\n\n      // Balance checks\n      const escrowAfter     = await totalEscrow();\n      const workerAfter     = await usdcBal(WORKER);\n      const employerAfter   = await usdcBal(EMPLOYER);\n      const workerDelta     = workerAfter   - workerBefore;\n      const employerDelta   = employerAfter - employerBefore;\n\n      if (escrowAfter !== escrowBefore) throw new Error(`totalEscrow mismatch: before=${escrowBefore} after=${escrowAfter}`);\n      if (workerDelta !== OWED) throw new Error(`worker delta wrong: got ${workerDelta} want ${OWED}`);\n      // Employer spent 10 USDC escrow, got back 2.5 refund → net -7.5\n      const expectedEmployerDelta = REFUND - ESCROW;\n      if (employerDelta !== expectedEmployerDelta) throw new Error(`employer delta wrong: got ${employerDelta} want ${expectedEmployerDelta}`);\n\n      flow.finalStatus       = STATUS_NAME[s6.status];\n      flow.finalEscrow       = formatUnits(s6.escrow, 6);\n      flow.workerBalanceDelta  = `+${formatUnits(workerDelta, 6)} USDC`;\n      flow.employerBalanceDelta = `${formatUnits(employerDelta, 6)} USDC`;\n      flow.passed = true;\n      console.log(`  PASS  worker+${formatUnits(workerDelta,6)} employer${formatUnits(employerDelta,6)}`);\n    } catch (e: unknown) {\n      flow.failure = (e as Error).message;\n      console.error(`  FAIL: ${flow.failure}`);\n    }\n    results.push(flow);\n  }\n\n  // =========================================================================\n  // FLOW 2 — Cancel before clock-in: 4 USDC/h, 1h\n  // =========================================================================\n  {\n    const flow: FlowResult = { name: \"Flow 2: Cancel before clock-in\", passed: false, txs: [] };\n    console.log(\"--- Flow 2: Cancel before clock-in ---\");\n    try {\n      const employerBefore = await usdcBal(EMPLOYER);\n\n      // hourlyRate = 4 USDC/h; maxSeconds = 3600 (1h) => escrow = 4 USDC\n      const RATE   = USDC_6(4);\n      const DUR    = 3600;\n      const ESCROW = USDC_6(4);\n\n      const createData = encodeFunctionData({ abi: ABI, functionName: \"createShift\", args: [WORKER, RATE, DUR] });\n      const t1 = await sendTx(EMPLOYER, CONTRACT, createData, \"createShift\");\n      flow.txs.push({ step: \"createShift\", hash: t1.hash, block: Number(t1.block), gasUsed: Number(t1.gasUsed) });\n      console.log(`  createShift  tx=${t1.hash} block=${t1.block}`);\n\n      const nextId = await pub.readContract({ address: CONTRACT, abi: ABI, functionName: \"nextShiftId\" });\n      const shiftId = nextId - 1n;\n      flow.shiftId = Number(shiftId);\n\n      const s1 = await readShift(shiftId);\n      if (s1.status !== 1) throw new Error(`Expected Funded(1) got ${s1.status}`);\n      if (s1.escrow !== ESCROW) throw new Error(`escrow mismatch`);\n      console.log(`  shiftId=${shiftId} state=Funded escrow=${formatUnits(s1.escrow, 6)}`);\n\n      const cancelData = encodeFunctionData({ abi: ABI, functionName: \"cancel\", args: [shiftId] });\n      const t2 = await sendTx(EMPLOYER, CONTRACT, cancelData, \"cancel\");\n      flow.txs.push({ step: \"cancel\", hash: t2.hash, block: Number(t2.block), gasUsed: Number(t2.gasUsed) });\n      console.log(`  cancel       tx=${t2.hash} block=${t2.block}`);\n\n      const s2 = await readShift(shiftId);\n      if (s2.status !== 7) throw new Error(`Expected Cancelled(7) got ${s2.status}`);\n      if (s2.escrow !== 0n) throw new Error(`escrow not zero after cancel`);\n\n      const employerAfter = await usdcBal(EMPLOYER);\n      const employerDelta = employerAfter - employerBefore;\n      // Net should be 0: paid 4 USDC escrow, got 4 USDC back\n      if (employerDelta !== 0n) throw new Error(`employer delta wrong: ${employerDelta}`);\n\n      const workerAfter = await usdcBal(WORKER);\n      // Worker balance unchanged\n      console.log(`  state=Cancelled escrow=0 employer net=${formatUnits(employerDelta,6)}`);\n\n      flow.finalStatus       = STATUS_NAME[s2.status];\n      flow.finalEscrow       = formatUnits(s2.escrow, 6);\n      flow.workerBalanceDelta  = \"+0 USDC\";\n      flow.employerBalanceDelta = \"+0 USDC (net: paid 4, refunded 4)\";\n      flow.passed = true;\n      console.log(`  PASS`);\n    } catch (e: unknown) {\n      flow.failure = (e as Error).message;\n      console.error(`  FAIL: ${flow.failure}`);\n    }\n    results.push(flow);\n  }\n\n  // =========================================================================\n  // FLOW 3 — Zero attestation: 3 USDC/h, 1h; attest 0; refundUnused\n  // =========================================================================\n  {\n    const flow: FlowResult = { name: \"Flow 3: Zero attestation\", passed: false, txs: [] };\n    console.log(\"--- Flow 3: Zero attestation ---\");\n    try {\n      const employerBefore = await usdcBal(EMPLOYER);\n\n      const RATE   = USDC_6(3);\n      const DUR    = 3600;\n      const ESCROW = USDC_6(3);\n\n      const createData = encodeFunctionData({ abi: ABI, functionName: \"createShift\", args: [WORKER, RATE, DUR] });\n      const t1 = await sendTx(EMPLOYER, CONTRACT, createData, \"createShift\");\n      flow.txs.push({ step: \"createShift\", hash: t1.hash, block: Number(t1.block), gasUsed: Number(t1.gasUsed) });\n      console.log(`  createShift  tx=${t1.hash} block=${t1.block}`);\n\n      const nextId = await pub.readContract({ address: CONTRACT, abi: ABI, functionName: \"nextShiftId\" });\n      const shiftId = nextId - 1n;\n      flow.shiftId = Number(shiftId);\n\n      // Worker clocks in then out\n      const ciData = encodeFunctionData({ abi: ABI, functionName: \"clockIn\",  args: [shiftId] });\n      const t2 = await sendTx(WORKER, CONTRACT, ciData, \"clockIn\");\n      flow.txs.push({ step: \"clockIn\", hash: t2.hash, block: Number(t2.block), gasUsed: Number(t2.gasUsed) });\n      const coData = encodeFunctionData({ abi: ABI, functionName: \"clockOut\", args: [shiftId] });\n      const t3 = await sendTx(WORKER, CONTRACT, coData, \"clockOut\");\n      flow.txs.push({ step: \"clockOut\", hash: t3.hash, block: Number(t3.block), gasUsed: Number(t3.gasUsed) });\n      console.log(`  clockIn/Out  blocks=${t2.block}/${t3.block}`);\n\n      // Attest 0 seconds\n      const attestData = encodeFunctionData({ abi: ABI, functionName: \"attest\", args: [shiftId, 0] });\n      const t4 = await sendTx(EMPLOYER, CONTRACT, attestData, \"attest(0)\");\n      flow.txs.push({ step: \"attest(0s)\", hash: t4.hash, block: Number(t4.block), gasUsed: Number(t4.gasUsed) });\n      console.log(`  attest(0)    tx=${t4.hash} block=${t4.block}`);\n      const s4 = await readShift(shiftId);\n      if (s4.status !== 4) throw new Error(`Expected Attested(4) got ${s4.status}`);\n      if (s4.owed !== 0n) throw new Error(`owed should be 0 after zero-attestation`);\n      console.log(`  state=Attested owed=0`);\n\n      // Verify claim reverts with NothingToClaim\n      // (use eth_call to check without consuming gas)\n      try {\n        const claimData = encodeFunctionData({ abi: ABI, functionName: \"claim\", args: [shiftId] });\n        await rpc(\"eth_call\", [{ from: WORKER, to: CONTRACT, data: claimData }, \"latest\"]);\n        throw new Error(\"claim should have reverted but did not\");\n      } catch (ce: unknown) {\n        const msg = (ce as Error).message;\n        if (!msg.includes(\"NothingToClaim\") && !msg.includes(\"0x83e02bff\")) {\n          // allow if it's a generic revert we expect\n          if (!msg.includes(\"revert\") && !msg.includes(\"execution reverted\")) {\n            throw new Error(`claim did not revert with NothingToClaim: ${msg}`);\n          }\n        }\n        console.log(`  claim() correctly reverts (NothingToClaim)`);\n      }\n\n      // refundUnused → full 3 USDC back to employer, status Settled\n      const refundData = encodeFunctionData({ abi: ABI, functionName: \"refundUnused\", args: [shiftId] });\n      const t5 = await sendTx(THIRD, CONTRACT, refundData, \"refundUnused\");\n      flow.txs.push({ step: \"refundUnused\", hash: t5.hash, block: Number(t5.block), gasUsed: Number(t5.gasUsed) });\n      console.log(`  refundUnused tx=${t5.hash} block=${t5.block}`);\n\n      const s5 = await readShift(shiftId);\n      if (s5.status !== 6) throw new Error(`Expected Settled(6) got ${s5.status}`);\n      if (s5.escrow !== 0n) throw new Error(`escrow not zero`);\n\n      const employerAfter = await usdcBal(EMPLOYER);\n      const employerDelta = employerAfter - employerBefore;\n      // Net should be 0: paid 3 USDC escrow, got 3 USDC refund back\n      if (employerDelta !== 0n) throw new Error(`employer delta wrong: ${employerDelta}`);\n\n      flow.finalStatus       = STATUS_NAME[s5.status];\n      flow.finalEscrow       = formatUnits(s5.escrow, 6);\n      flow.workerBalanceDelta  = \"+0 USDC\";\n      flow.employerBalanceDelta = \"+0 USDC (net: paid 3, refunded 3)\";\n      flow.passed = true;\n      console.log(`  PASS`);\n    } catch (e: unknown) {\n      flow.failure = (e as Error).message;\n      console.error(`  FAIL: ${flow.failure}`);\n    }\n    results.push(flow);\n  }\n\n  // =========================================================================\n  // Summary\n  // =========================================================================\n\n  console.log(\"\\n=== Summary ===\");\n  let allPassed = true;\n  for (const f of results) {\n    const icon = f.passed ? \"PASS\" : \"FAIL\";\n    console.log(`  ${icon}  ${f.name}${f.failure ? \": \" + f.failure : \"\"}`);\n    if (!f.passed) allPassed = false;\n  }\n\n  // Get current block for the report\n  const currentBlock = await rpc(\"eth_blockNumber\") as string;\n  const testedAtBlock = parseInt(currentBlock, 16);\n\n  // Build JSON output\n  const output = {\n    network: \"Arc Testnet\",\n    chainId: CHAIN_ID,\n    forkRpc: FORK_RPC,\n    testedViaFork: true,\n    testedAtBlock,\n    contractAddress: CONTRACT,\n    usdcAddress: USDC_ADDR,\n    wallets: {\n      employer: EMPLOYER,\n      worker:   WORKER,\n      third:    THIRD,\n      note: \"Impersonated anvil accounts — no private keys held or stored\",\n    },\n    allPassed,\n    flows: results,\n    generatedAt: new Date().toISOString(),\n  };\n\n  mkdirSync(dirname(\"/home/user/app/testnet-e2e.json\"), { recursive: true });\n  writeFileSync(\"/home/user/app/testnet-e2e.json\", JSON.stringify(output, null, 2));\n  console.log(\"\\nResults written to testnet-e2e.json\");\n\n  process.exit(allPassed ? 0 : 1);\n}\n\nmain().catch(e => { console.error(e); process.exit(1); });\n","totalLines":560}}
