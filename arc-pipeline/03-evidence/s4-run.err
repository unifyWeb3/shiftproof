{"kind":"data","event":{"type":"file_write_streaming","toolCallId":"01a17b41-7f0d-733e-9717-bfff6e0abb01","path":"/home/user/fork-tests/shiftproof-e2e.ts","status":"running","chunk":"// ---------------------------------------------------------------------------\n// Constants\n// ---------------------------------------------------------------------------\n\n// The live deployed contract — recorded for provenance only.\n// Tests run against a fresh fork deployment (see LIMITATION in header).\nconst LIVE_CONTRACT = \"0x39845ad25394ec0a6c15ebc5d8968d9c70bb41a6\" as Address;\nconst LIVE_USDC     = \"0x3600000000000000000000000000000000000000\" as Address;\nconst CHAIN_ID   = 5042002;\nconst FORK_RPC   = \"https://rpc.testnet.arc.io\";\nconst ANVIL_PORT = 8545;\nconst ANVIL_RPC  = `http://127.0.0.1:${ANVIL_PORT}`;\n\n// Deterministic test addresses (no private keys needed — impersonated)\nconst DEPLOYER = \"0x0000000000000000000000000000000000000001\" as Address;\nconst EMPLOYER = \"0x1111111111111111111111111111111111111111\" as Address;\nconst WORKER   = \"0x2222222222222222222222222222222222222222\" as Address;\nconst THIRD    = \"0x3333333333333333333333333333333333333333\" as Address;\n\n// USDC amounts (6-decimal)\nconst USDC_6 = (n: number) => BigInt(Math.round(n * 1e6));","oldContent":"// ---------------------------------------------------------------------------\n// Constants\n// ---------------------------------------------------------------------------\n\nconst CONTRACT   = \"0x39845ad25394ec0a6c15ebc5d8968d9c70bb41a6\" as Address;\nconst USDC_ADDR  = \"0x3600000000000000000000000000000000000000\" as Address;\nconst CHAIN_ID   = 5042002;\nconst FORK_RPC   = \"https://rpc.testnet.arc.io\";\nconst ANVIL_PORT = 8545;\nconst ANVIL_RPC  = `http://127.0.0.1:${ANVIL_PORT}`;\n\n// Deterministic test addresses (no private keys needed — impersonated)\nconst EMPLOYER = \"0x1111111111111111111111111111111111111111\" as Address;\nconst WORKER   = \"0x2222222222222222222222222222222222222222\" as Address;\nconst THIRD    = \"0x3333333333333333333333333333333333333333\" as Address;\n\n// USDC amounts (6-decimal)\nconst USDC_6 = (n: number) => BigInt(Math.round(n * 1e6));","totalLines":21,"oldTotalLines":18}}
