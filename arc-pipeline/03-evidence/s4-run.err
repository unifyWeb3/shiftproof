{"kind":"data","event":{"type":"file_write_streaming","toolCallId":"01a17b41-6722-71c1-9696-a92d9151f7e5","path":"/home/user/fork-tests/shiftproof-e2e.ts","status":"running","chunk":"/**\n * ShiftProof V1 — Arc Testnet Fork E2E\n *\n * Forks Arc Testnet at the tip, then deploys fresh MockUSDC + ShiftProof\n * instances onto the fork so transactions succeed without hitting the\n * Arc-specific USDC precompile (0x1800…0001) that does not exist in\n * vanilla anvil.  The same ShiftProof bytecode is tested; only the USDC\n * address differs from the live deployment.\n *\n * LIMITATION: The live contract at 0x39845…41a6 uses Arc USDC\n * (0x3600…0000), which calls a chain-specific precompile that is\n * unavailable on an anvil fork.  This fork test deploys a fresh\n * ShiftProof with MockUSDC to exercise the identical logic and bytecode.\n *\n * No private keys are used.  All senders are obtained via\n * anvil_impersonateAccount + anvil_setBalance.\n *\n * Run:  bun run fork-tests/shiftproof-e2e.ts\n */\n\nimport { createPublicClient, http,\n         formatUnits, encodeFunctionData, keccak256,\n         encodeAbiParameters, parseAbiParameters, pad, toHex,\n         type Address, type Hex } from \"viem\";\nimport { writeFileSync, mkdirSync } from \"fs\";\nimport { dirname } from \"path\";","oldContent":"/**\n * ShiftProof V1 — Arc Testnet Fork E2E\n *\n * Forks Arc Testnet at the tip, impersonates funded employer/worker\n * wallets, and exercises three flows against the already-deployed\n * contract at 0x39845ad25394ec0a6c15ebc5d8968d9c70bb41a6.\n *\n * No private keys are used. All senders are obtained via\n * anvil_impersonateAccount + anvil_setBalance.\n * USDC balances are funded by writing the ERC-20 balance storage slot.\n *\n * Run:  bun run fork-tests/shiftproof-e2e.ts\n */\n\nimport { createPublicClient, createWalletClient, http, parseUnits,\n         formatUnits, encodeFunctionData, getAddress, keccak256,\n         encodeAbiParameters, parseAbiParameters, pad, toHex,\n         type Address, type Hex } from \"viem\";\nimport { privateKeyToAccount } from \"viem/accounts\";\nimport { arcTestnet } from \"viem/chains\";\nimport { readFileSync, writeFileSync, mkdirSync } from \"fs\";\nimport { execSync } from \"child_process\";\nimport { dirname } from \"path\";","totalLines":26,"oldTotalLines":23}}
