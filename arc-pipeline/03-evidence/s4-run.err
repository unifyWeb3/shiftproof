{"kind":"data","event":{"type":"tool_call","status":"complete","toolCallId":"01a17b3f-ae5a-712e-aa39-6ab7297adef6","toolName":"read_file","args":{"file_path":"/home/user/app/src/onchain-facts.ts","limit":80},"result":"{\"lc\":1,\"type\":\"constructor\",\"id\":[\"langchain_core\",\"messages\",\"ToolMessage\"],\"kwargs\":{\"status\":\"success\",\"content\":[{\"type\":\"text\",\"text\":\"     1\\t/*\\n     2\\t * Onchain facts for this app. GENERATED — do not edit.\\n     3\\t *\\n     4\\t * Arc Studio writes this file from its onchain facts registry, so the values here are\\n     5\\t * the ones Arc Studio itself deploys and links against. Edits are overwritten.\\n     6\\t *\\n     7\\t * Import a fact instead of typing one:\\n     8\\t *\\n     9\\t *   import { getUsdc, requireChain, buildTxExplorerUrl } from '@/onchain-facts';\\n    10\\t *\\n    11\\t * A chain's gas token and its ERC-20 USDC are separate facts. On Arc both are\\n    12\\t * USDC, at different decimal counts: 'nativeCurrency' for the gas token,\\n    13\\t * 'usdc' for the ERC-20. Mixing the two is a 10^12 error on a money path.\\n    14\\t */\\n    15\\t\\n    16\\texport const USDC_DECIMALS = 6;\\n    17\\t\\n    18\\texport interface TokenFact {\\n    19\\t  symbol: string;\\n    20\\t  address: string;\\n    21\\t  decimals: number;\\n    22\\t}\\n    23\\t\\n    24\\texport interface NativeCurrencyFact {\\n    25\\t  symbol: string;\\n    26\\t  decimals: number;\\n    27\\t  /** True when the gas token IS USDC, which makes 'decimals' above the gas decimals. */\\n    28\\t  isUsdc: boolean;\\n    29\\t}\\n    30\\t\\n    31\\texport interface OnchainChain {\\n    32\\t  chainId: number;\\n    33\\t  name: string;\\n    34\\t  isTestnet: boolean;\\n    35\\t  /** Rollup / alt-EVM family. Absent for an L1 and for a chain in no shared-stack family. */\\n    36\\t  family?: string;\\n    37\\t  explorerBase: string;\\n    38\\t  rpcUrls: string[];\\n    39\\t  nativeCurrency: NativeCurrencyFact;\\n    40\\t  /** Absent when no USDC contract is deployed on the chain. */\\n    41\\t  usdc?: TokenFact;\\n    42\\t  cctpDomain?: number;\\n    43\\t  /** Circle SCP blockchain enum. Absent unless the deploy tool supports the chain. */\\n    44\\t  scpBlockchain?: string;\\n    45\\t}\\n    46\\t\\n    47\\texport interface ProtocolContractFact {\\n    48\\t  name: string;\\n    49\\t  address: string;\\n    50\\t  protocol: 'CCTP' | 'Gateway';\\n    51\\t  networkKind?: 'testnet' | 'mainnet';\\n    52\\t}\\n    53\\t\\n    54\\tinterface OnchainFacts {\\n    55\\t  chains: OnchainChain[];\\n    56\\t  protocolContracts: ProtocolContractFact[];\\n    57\\t}\\n    58\\t\\n    59\\tconst FACTS: OnchainFacts = {\\n    60\\t  \\\"chains\\\": [\\n    61\\t    {\\n    62\\t      \\\"chainId\\\": 5042002,\\n    63\\t      \\\"name\\\": \\\"Arc Testnet\\\",\\n    64\\t      \\\"isTestnet\\\": true,\\n    65\\t      \\\"family\\\": \\\"arc\\\",\\n    66\\t      \\\"explorerBase\\\": \\\"https://explorer.testnet.arc.io\\\",\\n    67\\t      \\\"rpcUrls\\\": [\\n    68\\t        \\\"https://rpc.testnet.arc.io\\\"\\n    69\\t      ],\\n    70\\t      \\\"nativeCurrency\\\": {\\n    71\\t        \\\"symbol\\\": \\\"USDC\\\",\\n    72\\t        \\\"decimals\\\": 18,\\n    73\\t        \\\"isUsdc\\\": true\\n    74\\t      },\\n    75\\t      \\\"usdc\\\": {\\n    76\\t        \\\"symbol\\\": \\\"USDC\\\",\\n    77\\t        \\\"address\\\": \\\"0x3600000000000000000000000000000000000000\\\",\\n    78\\t        \\\"decimals\\\": 6\\n    79\\t      },\\n    80\\t      \\\"cctpDomain\\\": 26,\\n\\n[Read 80 lines (lines 1-80 of 621 total). 541 lines remaining from offset 80.]\"}],\"tool_call_id\":\"toolu_bdrk_01H2JLr3wP8dsXy39fhHMsvQ\",\"name\":\"read_file\",\"metadata\":{\"versions\":{\"@langchain/core\":\"1.2.18\"}},\"additional_kwargs\":{},\"response_metadata\":{}}}"}}
