{"kind":"data","event":{"type":"sandbox_step","step":"file_written","status":"running","path":"/home/user/app/src/lib/share.ts","toolCallId":"01a17b49-0b63-77e3-8594-26e480ee31c3"}}
{"kind":"data","event":{"type":"file_write_streaming","toolCallId":"01a17b49-0b63-77e3-8594-26e480ee31c3","path":"/home/user/app/src/lib/share.ts","status":"running","chunk":"// Share link helpers — do not edit; generated by Arc Studio.\nconst STUDIO_ORIGINS = ['https://studio.arc.io', 'https://studio-staging.arc.io']\nconst HANDSHAKE_TIMEOUT_MS = 1500\nconst trimSlash = (url: string) => url.replace(/\\/+$/, '')\nconst ownBase = () =>\n  trimSlash(\n    new URL(\n      (import.meta as { env?: { BASE_URL?: string } }).env?.BASE_URL ?? '/',\n      `${window.location.origin}/`,\n    ).href,\n  )\nconst ABSOLUTE_URL = /^([a-z][a-z\\d+.-]*:|\\/\\/)/i\nconst UNSAFE_PATH_CHAR = /%(?![\\da-f]{2})|[^\\w\\-.~!$&'()*+,;=:@%/]/giu\nlet known: string | undefined\nlet listening = false\nconst waiters = new Set<(url: string) => void>()\n\nconst originOf = (url: string) => {\n  try { return new URL(url).origin } catch { return '' }\n}\n\nexport function parentStudioOrigins(\n  ancestorOrigins?: ArrayLike<string>,\n  referrer = '',\n): string[] {\n  const k = [ancestorOrigins?.[0] ?? '', originOf(referrer)].find((o) =>\n    STUDIO_ORIGINS.includes(o),\n  )\n  return k ? [k] : STUDIO_ORIGINS\n}\n\nconst onMessage = (event: MessageEvent) => {\n  if (!STUDIO_ORIGINS.includes(event.origin) || event.source !== window.parent) return\n  const data = event.data as { type?: string; url?: unknown } | null\n  if (\n    data?.type !== 'arc-share:url' ||\n    typeof data.url !== 'string' ||\n    !data.url.startsWith(`${event.origin}/`)\n  )\n    return\n  known = trimSlash(data.url)\n  listening = false\n  window.removeEventListener('message', onMessage)\n  for (const resolve of waiters) resolve(known)\n  waiters.clear()\n}\n\nexport function getShareBase(): Promise<string> {\n  if (window.self === window.top) return Promise.resolve(ownBase())\n  if (known) return Promise.resolve(known)\n  return new Promise<string>((resolve) => {\n    const timer = setTimeout(() => {\n      waiters.delete(settle)\n      resolve(ownBase())\n    }, HANDSHAKE_TIMEOUT_MS)\n    const settle = (url: string) => {\n      clearTimeout(timer)\n      resolve(url)\n    }\n    waiters.add(settle)\n    if (!listening) {\n      listening = true\n      window.addEventListener('message', onMessage)\n    }\n    for (const origin of parentStudioOrigins(\n      window.location.ancestorOrigins,\n      document.referrer,\n    )) {\n      window.parent.postMessage({ type: 'arc-share:hello' }, origin)\n    }\n  })\n}\n\nexport async function buildShareLink(path: string): Promise<string> {\n  if (ABSOLUTE_URL.test(path))\n    throw new TypeError(\n      'buildShareLink expects a path such as \"/shift/1\", not an absolute URL',\n    )\n  const [, route, rest] = /^([^?#]*)(.*)$/s.exec(path) as RegExpExecArray\n  const encoded = route.replace(\n    UNSAFE_PATH_CHAR,\n    (char) => (char === '%' ? '%25' : encodeURIComponent(char)),\n  )\n  return (await getShareBase()) + (encoded.startsWith('/') ? encoded : `/${encoded}`) + rest\n}\n\nlet syncInstalled = false\nexport function installShareSync(): void {\n  if (window.self === window.top || syncInstalled) return\n  syncInstalled = true\n  const targets = parentStudioOrigins(\n    window.location.ancestorOrigins,\n    document.referrer,\n  )\n  let lastPosted: string | undefined\n  let timer: ReturnType<typeof setTimeout> | undefined\n  const post = () => {\n    const key = location.pathname + location.search\n    if (key === lastPosted) return\n    lastPosted = key\n    for (const origin of targets) {\n      window.parent.postMessage(\n        { type: 'arc-share:navigated', path: location.pathname, search: location.search },\n        origin,\n      )\n    }\n  }\n  const schedule = () => {\n    timer ??= setTimeout(() => {\n      timer = undefined\n      post()\n    }, 100)\n  }\n  for (const method of ['pushState', 'replaceState'] as const) {\n    const original = history[method]\n    history[method] = function (this: History, ...args: Parameters<History['pushState']>) {\n      const result = original.apply(this, args)\n      schedule()\n      return result\n    }\n  }\n  window.addEventListener('popstate', schedule)\n  post()\n}\n","totalLines":125}}
