{"kind":"data","event":{"type":"sandbox_step","step":"file_written","status":"running","path":"/home/user/app/src/components/TxButton.tsx","toolCallId":"01a17b49-a73b-70e8-81c8-dc2e5f4d56dd"}}
{"kind":"data","event":{"type":"file_write_streaming","toolCallId":"01a17b49-a73b-70e8-81c8-dc2e5f4d56dd","path":"/home/user/app/src/components/TxButton.tsx","status":"running","chunk":"/**\n * Simulate-then-sign CTA button.\n * Shows a confirmation card before sending.\n * On simulation failure, decodes and displays the error.\n */\nimport { useState, type ReactNode } from 'react'\nimport { usePublicClient, useWriteContract, useWaitForTransactionReceipt, useAccount } from 'wagmi'\nimport { type Abi, type Address, type ContractFunctionArgs, type ContractFunctionName } from 'viem'\nimport { Loader2, ExternalLink, CheckCircle2, XCircle, AlertTriangle } from 'lucide-react'\nimport { decodeContractError } from '../lib/format'\nimport { explorerTx, CHAIN_ID } from '../lib/contract'\nimport { useWrongChain } from './NetworkGuard'\n\ninterface TxButtonProps<\n  TAbi extends Abi,\n  TFunctionName extends ContractFunctionName<TAbi, 'nonpayable' | 'payable'>,\n> {\n  label: ReactNode\n  address: Address\n  abi: TAbi\n  functionName: TFunctionName\n  args: ContractFunctionArgs<TAbi, 'nonpayable' | 'payable', TFunctionName>\n  confirmCard: ReactNode  // human-readable summary shown before signing\n  disabled?: boolean\n  onSuccess?: (hash: string) => void\n  className?: string\n}\n\nexport default function TxButton<\n  TAbi extends Abi,\n  TFunctionName extends ContractFunctionName<TAbi, 'nonpayable' | 'payable'>,\n>({\n  label,\n  address,\n  abi,\n  functionName,\n  args,\n  confirmCard,\n  disabled,\n  onSuccess,\n  className = '',\n}: TxButtonProps<TAbi, TFunctionName>) {\n  const { address: walletAddress } = useAccount()\n  const publicClient = usePublicClient({ chainId: CHAIN_ID })\n  const wrongChain = useWrongChain()\n\n  const [phase, setPhase] = useState<'idle' | 'simulating' | 'confirming' | 'signing' | 'waiting' | 'success' | 'error'>('idle')\n  const [simError, setSimError] = useState<string | null>(null)\n  const [txHash, setTxHash] = useState<string | null>(null)\n  const [txError, setTxError] = useState<string | null>(null)\n  const [showConfirm, setShowConfirm] = useState(false)\n\n  const { writeContractAsync } = useWriteContract()\n  const { isLoading: isConfirming } = useWaitForTransactionReceipt({\n    hash: txHash as `0x${string}` | undefined,\n    chainId: CHAIN_ID,\n  })\n\n  const reset = () => {\n    setPhase('idle')\n    setSimError(null)\n    setTxHash(null)\n    setTxError(null)\n    setShowConfirm(false)\n  }\n\n  const handleClick = async () => {\n    if (!walletAddress || wrongChain || !publicClient) return\n    setSimError(null)\n    setPhase('simulating')\n    try {\n      await publicClient.simulateContract({\n        address,\n        abi,\n        functionName,\n        // eslint-disable-next-line @typescript-eslint/no-explicit-any\n        args: args as any,\n        account: walletAddress,\n      })\n      setPhase('confirming')\n      setShowConfirm(true)\n    } catch (err) {\n      setSimError(decodeContractError(err))\n      setPhase('error')\n    }\n  }\n\n  const handleSign = async () => {\n    setShowConfirm(false)\n    setPhase('signing')\n    try {\n      const hash = await writeContractAsync({\n        address,\n        abi,\n        functionName,\n        // eslint-disable-next-line @typescript-eslint/no-explicit-any\n        args: args as any,\n        chainId: CHAIN_ID,\n      })\n      setTxHash(hash)\n      setPhase('waiting')\n    } catch (err) {\n      const msg = decodeContractError(err)\n      if (msg === 'Transaction cancelled in your wallet.') {\n        reset()\n        return\n      }\n      setTxError(msg)\n      setPhase('error')\n    }\n  }\n\n  // Watch for confirmation\n  const receipt = useWaitForTransactionReceipt({\n    hash: txHash as `0x${string}` | undefined,\n    chainId: CHAIN_ID,\n  })\n  if (receipt.isSuccess && phase === 'waiting') {\n    setPhase('success')\n    if (txHash) onSuccess?.(txHash)\n  }\n  if (receipt.isError && phase === 'waiting') {\n    setTxError('Transaction failed on-chain.')\n    setPhase('error')\n  }\n\n  const isBlocked = !walletAddress || wrongChain || disabled\n  const isLoading = phase === 'simulating' || phase === 'signing' || phase === 'waiting' || isConfirming\n\n  return (\n    <div className=\"w-full\">\n      {/* Main button */}\n      {phase !== 'success' && (\n        <button\n          onClick={handleClick}\n          disabled={isBlocked || isLoading}\n          className={`w-full flex items-center justify-center gap-2 rounded-2xl py-3 px-5 text-sm font-semibold text-white transition-all hover:scale-[1.01] active:scale-[0.99] disabled:cursor-not-allowed disabled:opacity-40 ${className}`}\n          style={{ background: 'var(--accent)' }}\n        >\n          {isLoading && <Loader2 className=\"size-4 animate-spin\" />}\n          {phase === 'simulating' && 'Checking…'}\n          {phase === 'signing'    && 'Confirm in wallet…'}\n          {phase === 'waiting'    && 'Confirming…'}\n          {(phase === 'idle' || phase === 'error') && label}\n        </button>\n      )}\n\n      {/* Simulation error */}\n      {phase === 'error' && simError && (\n        <div className=\"mt-3 rounded-xl p-3 flex items-start gap-2 text-sm\" style={{ background: '#fef2f2', border: '1px solid #fca5a5' }}>\n          <XCircle className=\"size-4 shrink-0 mt-0.5\" style={{ color: 'var(--danger)' }} />\n          <div style={{ color: '#991b1b' }}>{simError}</div>\n        </div>\n      )}\n\n      {/* Tx error */}\n      {phase === 'error' && txError && (\n        <div className=\"mt-3 rounded-xl p-3 flex items-start gap-2 text-sm\" style={{ background: '#fef2f2', border: '1px solid #fca5a5' }}>\n          <XCircle className=\"size-4 shrink-0 mt-0.5\" style={{ color: 'var(--danger)' }} />\n          <div>\n            <p style={{ color: '#991b1b' }}>{txError}</p>\n            {txHash && (\n              <a href={explorerTx(txHash)} target=\"_blank\" rel=\"noopener noreferrer\" className=\"text-xs mt-1 inline-flex items-center gap-1 hover:underline\" style={{ color: 'var(--accent-hover)' }}>\n                View tx <ExternalLink className=\"size-3\" />\n              </a>\n            )}\n            <button onClick={reset} className=\"text-xs mt-2 font-semibold hover:underline block\" style={{ color: 'var(--accent)' }}>\n              Try again\n            </button>\n          </div>\n        </div>\n      )}\n\n      {/* Success */}\n      {phase === 'success' && txHash && (\n        <div className=\"rounded-2xl p-4 flex items-start gap-3\" style={{ background: '#f0fdf4', border: '1px solid #86efac' }}>\n          <CheckCircle2 className=\"size-5 shrink-0 mt-0.5\" style={{ color: 'var(--success)' }} />\n          <div>\n            <p className=\"font-semibold text-sm\" style={{ color: 'var(--success)' }}>Confirmed</p>\n            <a href={explorerTx(txHash)} target=\"_blank\" rel=\"noopener noreferrer\" className=\"text-xs mt-1 inline-flex items-center gap-1 hover:underline\" style={{ color: '#166534' }}>\n              View on explorer <ExternalLink className=\"size-3\" />\n            </a>\n            <button onClick={reset} className=\"text-xs mt-2 font-semibold hover:underline block\" style={{ color: 'var(--muted)' }}>\n              Do another\n            </button>\n          </div>\n        </div>\n      )}\n\n      {/* Confirmation card overlay */}\n      {showConfirm && (\n        <div className=\"fixed inset-0 z-50 flex items-end sm:items-center justify-center p-4\">\n          <div className=\"absolute inset-0 bg-black/30 backdrop-blur-sm\" onClick={() => { setShowConfirm(false); setPhase('idle') }} />\n          <div\n            className=\"relative w-full max-w-md rounded-3xl overflow-hidden\"\n            style={{ background: 'rgba(255,255,255,0.95)', backdropFilter: 'blur(40px) saturate(200%)' }}\n          >\n            <div className=\"h-1\" style={{ background: 'linear-gradient(90deg, #1061a6, #122d45)' }} />\n            <div className=\"p-6\">\n              <div className=\"flex items-center gap-2 mb-4\">\n                <AlertTriangle className=\"size-4\" style={{ color: '#d97706' }} />\n                <h3 className=\"font-semibold text-sm\" style={{ color: 'var(--ink)' }}>Confirm transaction</h3>\n              </div>\n              {confirmCard}\n              <div className=\"flex gap-3 mt-5\">\n                <button\n                  onClick={() => { setShowConfirm(false); setPhase('idle') }}\n                  className=\"flex-1 py-2.5 rounded-xl text-sm font-semibold border transition-all hover:scale-[1.01]\"\n                  style={{ borderColor: 'var(--border-strong)', color: 'var(--muted)' }}\n                >\n                  Cancel\n                </button>\n                <button\n                  onClick={handleSign}\n                  className=\"flex-1 py-2.5 rounded-xl text-sm font-semibold text-white transition-all hover:scale-[1.01] active:scale-[0.99]\"\n                  style={{ background: 'var(--accent)' }}\n                >\n                  Sign in wallet\n                </button>\n              </div>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  )\n}\n","totalLines":228}}
