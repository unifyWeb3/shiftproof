{"kind":"data","event":{"type":"file_write_streaming","toolCallId":"01a17b4c-3b43-724f-8cd4-77299873674a","path":"/home/user/app/src/pages/Proof.tsx","status":"running","chunk":"/**\n * /proof — look up any shift by ID; no wallet required.\n */\nimport { useState } from 'react'\nimport { Search } from 'lucide-react'\n\ninterface ProofProps { navigate: (p: string) => void }\n\nexport default function Proof({ navigate }: ProofProps) {\n  const [input, setInput] = useState('')\n\n  const handleSearch = () => {\n    const id = input.trim()\n    if (id && !isNaN(Number(id)) && Number(id) > 0) {\n      navigate(`/shift/${id}`)\n    }\n  }\n\n  return (\n    <div className=\"max-w-lg mx-auto space-y-6\">\n      <div>\n        <h1 className=\"display text-3xl font-bold\" style={{ color: 'var(--ink)', letterSpacing: '-0.02em' }}>\n          Verify a Shift\n        </h1>\n        <p className=\"mt-1 text-sm\" style={{ color: 'var(--muted)' }}>\n          Look up any shift's public receipt by ID. No wallet required.\n        </p>\n      </div>\n\n      <div\n        className=\"rounded-2xl p-6 space-y-4\"\n        style={{ background: 'var(--surface-strong)', border: '1px solid var(--border)' }}\n      >\n        <label className=\"text-xs font-medium block\" style={{ color: 'var(--muted)' }}>\n          Shift ID\n        </label>\n        <div className=\"flex gap-2\">\n          <input\n            type=\"number\"\n            value={input}\n            onChange={e => setInput(e.target.value)}\n            onKeyDown={e => e.key === 'Enter' && handleSearch()}\n            placeholder=\"e.g. 1\"\n            min=\"1\"\n            className=\"flex-1 rounded-xl px-4 py-3 text-lg tabular-nums outline-none focus:ring-2\"\n            style={{ background: 'var(--surface-muted)', border: '1px solid var(--border)', color: 'var(--ink)' }}\n          />\n          <button\n            onClick={handleSearch}\n            disabled={!input || isNaN(Number(input)) || Number(input) <= 0}\n            className=\"flex items-center gap-2 px-5 py-3 rounded-xl text-sm font-semibold text-white transition-all hover:scale-[1.02] active:scale-[0.98] disabled:opacity-40 disabled:cursor-not-allowed\"\n            style={{ background: 'var(--accent)' }}\n          >\n            <Search className=\"size-4\" />\n            View\n          </button>\n        </div>\n\n        <p className=\"text-xs\" style={{ color: 'var(--subtle)' }}>\n          Reads live from the Arc Testnet smart contract.\n          All shift data is public and permanent once recorded onchain.\n        </p>\n      </div>\n\n      <div className=\"text-sm\" style={{ color: 'var(--muted)' }}>\n        <p className=\"font-semibold mb-2\" style={{ color: 'var(--ink)' }}>What the receipt shows</p>\n        <ul className=\"space-y-1 list-disc list-inside\">\n          <li>Shift status and all timestamps (created, clocked in/out)</li>\n          <li>Employer and worker wallet addresses</li>\n          <li>Hourly rate, max duration, attested seconds</li>\n          <li>Escrowed USDC, amount owed, and whether it has been claimed</li>\n          <li>Direct explorer links to verify every transaction</li>\n        </ul>\n      </div>\n    </div>\n  )\n}\n","totalLines":78}}
