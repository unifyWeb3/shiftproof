{"kind":"data","event":{"type":"sandbox_step","step":"file_written","status":"running","path":"/home/user/app/src/pages/Employer.tsx","toolCallId":"01a17b4a-b567-740d-90cf-a6629921171d"}}
{"kind":"data","event":{"type":"file_write_streaming","toolCallId":"01a17b4a-b567-740d-90cf-a6629921171d","path":"/home/user/app/src/pages/Employer.tsx","status":"running","chunk":"import { useState, useEffect } from 'react'\nimport { useAccount, useReadContract, usePublicClient, useWriteContract, useWaitForTransactionReceipt } from 'wagmi'\nimport { erc20Abi, parseUnits } from 'viem'\nimport { ConnectKitButton } from 'connectkit'\nimport { Plus, RefreshCw, AlertCircle, Loader2, ExternalLink, CheckCircle2, XCircle } from 'lucide-react'\nimport { ABI, CONTRACT_ADDRESS, USDC_ADDRESS, CHAIN_ID, explorerTx } from '../lib/contract'\nimport {\n  parseUsdc, formatUsdc2, computeEscrow, secondsToDisplay, shortAddr, decodeContractError,\n} from '../lib/format'\nimport {\n  getCreatedIds, addCreatedId, addAssignedId, getTxHashes, recordTx,\n} from '../lib/storage'\nimport NetworkGuard, { useWrongChain } from '../components/NetworkGuard'\nimport ShiftCard from '../components/ShiftCard'\nimport TxButton from '../components/TxButton'\n\ninterface EmployerProps { navigate: (p: string) => void }\n\nexport default function Employer({ navigate }: EmployerProps) {\n  const { address, isConnected } = useAccount()\n  const wrongChain = useWrongChain()\n\n  // ---- Create shift form ----\n  const [workerAddr, setWorkerAddr] = useState('')\n  const [rateInput, setRateInput]   = useState('')\n  const [hoursInput, setHoursInput] = useState('')\n\n  const rateRaw     = rateInput   ? parseUsdc(rateInput)   : 0n\n  const hoursNum    = hoursInput  ? Math.min(24, parseFloat(hoursInput) || 0) : 0\n  const maxSeconds  = Math.round(hoursNum * 3600)\n  const escrowRaw   = (rateRaw > 0n && maxSeconds > 0) ? computeEscrow(rateRaw, maxSeconds) : 0n\n  const isValidForm =\n    workerAddr.startsWith('0x') && workerAddr.length === 42 &&\n    workerAddr.toLowerCase() !== address?.toLowerCase() &&\n    rateRaw > 0n && rateRaw <= 1_000_000_000n &&\n    maxSeconds > 0 && maxSeconds <= 86400 &&\n    escrowRaw > 0n && escrowRaw <= 10_000_000_000n\n\n  // ---- Approve then createShift ----\n  const [approvePhase, setApprovePhase] = useState<'idle' | 'simulating' | 'signing' | 'waiting' | 'done' | 'error'>('idle')\n  const [approveTx, setApproveTx] = useState<string | null>(null)\n  const [approveErr, setApproveErr] = useState<string | null>(null)\n  const [createPhase, setCreatePhase] = useState<'idle' | 'simulating' | 'signing' | 'waiting' | 'done' | 'error'>('idle')\n  const [createTx, setCreateTx] = useState<string | null>(null)\n  const [createErr, setCreateErr] = useState<string | null>(null)\n  const [showCreateConfirm, setShowCreateConfirm] = useState(false)\n  const [newShiftId, setNewShiftId] = useState<string | null>(null)\n\n  const publicClient = usePublicClient({ chainId: CHAIN_ID })\n  const { writeContractAsync } = useWriteContract()\n\n  const approveReceipt = useWaitForTransactionReceipt({ hash: approveTx as `0x${string}` | undefined, chainId: CHAIN_ID })\n  const createReceipt  = useWaitForTransactionReceipt({ hash: createTx  as `0x${string}` | undefined, chainId: CHAIN_ID })\n\n  useEffect(() => {\n    if (approveReceipt.isSuccess && approvePhase === 'waiting') setApprovePhase('done')\n    if (approveReceipt.isError   && approvePhase === 'waiting') { setApprovePhase('error'); setApproveErr('Approval failed on-chain.') }\n  }, [approveReceipt.isSuccess, approveReceipt.isError, approvePhase])\n\n  useEffect(() => {\n    if (createReceipt.isSuccess && createPhase === 'waiting') {\n      setCreatePhase('done')\n      // Derive shift ID from nextShiftId post-tx (we read below) or from logs\n    }\n    if (createReceipt.isError && createPhase === 'waiting') { setCreatePhase('error'); setCreateErr('Create shift failed on-chain.') }\n  }, [createReceipt.isSuccess, createReceipt.isError, createPhase])\n\n  // Read nextShiftId to deduce what was just created\n  const { data: nextId, refetch: refetchNextId } = useReadContract({\n    address: CONTRACT_ADDRESS,\n    abi: ABI,\n    functionName: 'nextShiftId',\n    chainId: CHAIN_ID,\n  })\n\n  // Track created IDs from storage\n  const [createdIds, setCreatedIds] = useState<string[]>([])\n  const [manualId, setManualId] = useState('')\n  useEffect(() => { setCreatedIds(getCreatedIds()) }, [])\n\n  // USDC balance of employer\n  const { data: usdcBalance, refetch: refetchBalance } = useReadContract({\n    address: USDC_ADDRESS,\n    abi: erc20Abi,\n    functionName: 'balanceOf',\n    args: [address ?? '0x0000000000000000000000000000000000000000'],\n    chainId: CHAIN_ID,\n    query: { enabled: !!address },\n  })\n\n  const handleSimulate = async () => {\n    if (!address || !publicClient || !isValidForm) return\n    setApproveErr(null)\n    setCreateErr(null)\n    setApprovePhase('simulating')\n    try {\n      // Simulate approve\n      await publicClient.simulateContract({\n        address: USDC_ADDRESS, abi: erc20Abi, functionName: 'approve',\n        args: [CONTRACT_ADDRESS, escrowRaw], account: address,\n      })\n      // Simulate createShift\n      await publicClient.simulateContract({\n        address: CONTRACT_ADDRESS, abi: ABI, functionName: 'createShift',\n        args: [workerAddr as `0x${string}`, rateRaw, maxSeconds],\n        account: address,\n      })\n      setApprovePhase('idle')\n      setShowCreateConfirm(true)\n    } catch (err) {\n      setApproveErr(decodeContractError(err))\n      setApprovePhase('error')\n    }\n  }\n\n  const handleApproveAndCreate = async () => {\n    if (!address) return\n    setShowCreateConfirm(false)\n    setApprovePhase('signing')\n    try {\n      const approveHash = await writeContractAsync({\n        address: USDC_ADDRESS, abi: erc20Abi, functionName: 'approve',\n        args: [CONTRACT_ADDRESS, escrowRaw], chainId: CHAIN_ID,\n      })\n      setApproveTx(approveHash)\n      setApprovePhase('waiting')\n      // wait for approval\n      await publicClient!.waitForTransactionReceipt({ hash: approveHash })\n      setApprovePhase('done')\n      recordTx('pending', 'approve', approveHash)\n\n      // now create\n      setCreatePhase('signing')\n      const createHash = await writeContractAsync({\n        address: CONTRACT_ADDRESS, abi: ABI, functionName: 'createShift',\n        args: [workerAddr as `0x${string}`, rateRaw, maxSeconds],\n        chainId: CHAIN_ID,\n      })\n      setCreateTx(createHash)\n      setCreatePhase('waiting')\n      const receipt = await publicClient!.waitForTransactionReceipt({ hash: createHash })\n      setCreatePhase('done')\n\n      // Extract shiftId from ShiftCreated log\n      await refetchNextId()\n      const logId = receipt.logs?.[0]?.topics?.[1]\n      const sid = logId ? String(BigInt(logId)) : String((nextId as bigint) - 1n)\n      setNewShiftId(sid)\n      addCreatedId(sid)\n      addAssignedId(sid)  // employer is also a participant\n      recordTx(sid, 'create', createHash)\n      setCreatedIds(getCreatedIds())\n      refetchBalance()\n    } catch (err) {\n      const msg = decodeContractError(err)\n      if (msg === 'Transaction cancelled in your wallet.') {\n        setApprovePhase('idle')\n        setCreatePhase('idle')\n        return\n      }\n      if (approvePhase === 'signing' || approvePhase === 'waiting') {\n        setApproveErr(msg); setApprovePhase('error')\n      } else {\n        setCreateErr(msg); setCreatePhase('error')\n      }\n    }\n  }\n\n  const resetCreateForm = () => {\n    setWorkerAddr(''); setRateInput(''); setHoursInput('')\n    setApprovePhase('idle'); setCreatePhase('idle')\n    setApproveErr(null); setCreateErr(null)\n    setApproveTx(null); setCreateTx(null)\n    setNewShiftId(null)\n  }\n\n  // ---- Per-shift actions (attest, refundUnused, cancel) ----\n  const [actionShiftId, setActionShiftId] = useState('')\n  const [attestHours, setAttestHours]     = useState('')\n\n  const { data: actionShift, refetch: refetchActionShift } = useReadContract({\n    address: CONTRACT_ADDRESS, abi: ABI, functionName: 'getShift',\n    args: [BigInt(actionShiftId || '0')],\n    chainId: CHAIN_ID,\n    query: { enabled: !!actionShiftId && actionShiftId !== '0' },\n  })\n\n  const asStatus    = actionShift ? Number(actionShift.status)     : -1\n  const asMax       = actionShift ? Number(actionShift.maxSeconds) : 0\n  const asEscrow    = actionShift ? (actionShift.escrow as bigint) : 0n\n  const asOwed      = actionShift ? (actionShift.owed   as bigint) : 0n\n  const asRate      = actionShift ? (actionShift.hourlyRate as bigint) : 0n\n  const attestSecs  = attestHours ? Math.round(parseFloat(attestHours) * 3600) : 0\n  const attestRaw   = computeEscrow(asRate, attestSecs)\n  const canAttest   = asStatus === 1 || asStatus === 2 || asStatus === 3\n  const canCancel   = asStatus === 1\n  const canRefund   = (asStatus === 4 || asStatus === 5) && asEscrow > asOwed\n  const isMyShift   = address && actionShift && (actionShift.employer as string).toLowerCase() === address.toLowerCase()\n\n  return (\n    <div className=\"space-y-8\">\n      <div>\n        <h1 className=\"display text-3xl font-bold\" style={{ color: 'var(--ink)', letterSpacing: '-0.02em' }}>\n          Employer Dashboard\n        </h1>\n        <p className=\"mt-1 text-sm\" style={{ color: 'var(--muted)' }}>\n          Fund shifts in USDC, attest hours, and manage payouts.\n        </p>\n      </div>\n\n      {!isConnected && (\n        <div className=\"rounded-2xl p-8 flex flex-col items-center gap-4 text-center\" style={{ background: 'var(--surface-muted)', border: '1px solid var(--border)' }}>\n          <p className=\"text-sm\" style={{ color: 'var(--muted)' }}>Connect your wallet to create and manage shifts.</p>\n          <ConnectKitButton />\n        </div>\n      )}\n\n      {isConnected && (\n        <>\n          <NetworkGuard>\n            {/* USDC balance */}\n            {usdcBalance !== undefined && (\n              <div className=\"rounded-2xl p-4 flex items-center justify-between\" style={{ background: 'var(--surface-strong)', border: '1px solid var(--border)' }}>\n                <div>\n                  <p className=\"text-xs font-semibold uppercase tracking-wider\" style={{ color: 'var(--subtle)' }}>USDC Balance</p>\n                  <p className=\"display text-2xl font-bold tabular-nums mt-0.5\" style={{ color: 'var(--ink)' }}>\n                    {formatUsdc2(usdcBalance as bigint)}\n                    <span className=\"text-base font-medium ml-1\" style={{ color: 'var(--subtle)' }}>USDC</span>\n                  </p>\n                </div>\n                <button onClick={() => refetchBalance()} className=\"p-2 rounded-lg hover:bg-slate-100\">\n                  <RefreshCw className=\"size-4\" style={{ color: 'var(--subtle)' }} />\n                </button>\n              </div>\n            )}\n\n            {/* Create shift */}\n            <section className=\"rounded-2xl p-5\" style={{ background: 'var(--surface-strong)', border: '1px solid var(--border)' }}>\n              <h2 className=\"font-semibold text-sm mb-4 flex items-center gap-2\" style={{ color: 'var(--ink)' }}>\n                <Plus className=\"size-4\" /> New Shift\n              </h2>\n\n              <div className=\"space-y-3\">\n                <div>\n                  <label className=\"text-xs font-medium mb-1 block\" style={{ color: 'var(--muted)' }}>Worker wallet address</label>\n                  <input\n                    type=\"text\"\n                    value={workerAddr}\n                    onChange={e => setWorkerAddr(e.target.value.trim())}\n                    placeholder=\"0x…\"\n                    className=\"w-full rounded-xl px-3 py-2.5 text-sm mono outline-none focus:ring-2\"\n                    style={{ background: 'var(--surface-muted)', border: '1px solid var(--border)', color: 'var(--ink)', focusRingColor: 'var(--focus)' }}\n                  />\n                  <p className=\"text-xs mt-1\" style={{ color: 'var(--subtle)' }}>\n                    WARNING: Do not enter names, emails, or personal data. Addresses only.\n                  </p>\n                </div>\n\n                <div className=\"grid grid-cols-2 gap-3\">\n                  <div>\n                    <label className=\"text-xs font-medium mb-1 block\" style={{ color: 'var(--muted)' }}>Hourly rate (USDC/hr)</label>\n                    <input\n                      type=\"number\"\n                      inputMode=\"decimal\"\n                      value={rateInput}\n                      onChange={e => setRateInput(e.target.value)}\n                      placeholder=\"5.00\"\n                      min=\"0.000001\"\n                      max=\"1000\"\n                      step=\"0.01\"\n                      className=\"w-full rounded-xl px-3 py-2.5 text-sm tabular-nums outline-none focus:ring-2\"\n                      style={{ background: 'var(--surface-muted)', border: '1px solid var(--border)', color: 'var(--ink)' }}\n                    />\n                  </div>\n                  <div>\n                    <label className=\"text-xs font-medium mb-1 block\" style={{ color: 'var(--muted)' }}>Max hours (up to 24)</label>\n                    <input\n                      type=\"number\"\n                      inputMode=\"decimal\"\n                      value={hoursInput}\n                      onChange={e => setHoursInput(e.target.value)}\n                      placeholder=\"2.00\"\n                      min=\"0\"\n                      max=\"24\"\n                      step=\"0.25\"\n                      className=\"w-full rounded-xl px-3 py-2.5 text-sm tabular-nums outline-none focus:ring-2\"\n                      style={{ background: 'var(--surface-muted)', border: '1px solid var(--border)', color: 'var(--ink)' }}\n                    />\n                  </div>\n                </div>\n\n                {/* Preview */}\n                {rateRaw > 0n && maxSeconds > 0 && (\n                  <div className=\"rounded-xl p-3 space-y-1 text-sm\" style={{ background: 'var(--surface-muted)', border: '1px solid var(--border)' }}>\n                    <div className=\"flex justify-between\">\n                      <span style={{ color: 'var(--muted)' }}>Duration</span>\n                      <span className=\"font-semibold tabular-nums\" style={{ color: 'var(--ink)' }}>\n                        {secondsToDisplay(maxSeconds)} ({maxSeconds} seconds exact)\n                      </span>\n                    </div>\n                    <div className=\"flex justify-between\">\n                      <span style={{ color: 'var(--muted)' }}>Escrow (floor)</span>\n                      <span className=\"font-semibold tabular-nums\" style={{ color: escrowRaw > 10_000_000_000n ? 'var(--danger)' : 'var(--success)' }}>\n                        {formatUsdc2(escrowRaw)} USDC\n                      </span>\n                    </div>\n                    {escrowRaw > 10_000_000_000n && (\n                      <p className=\"text-xs\" style={{ color: 'var(--danger)' }}>Escrow exceeds the 10,000 USDC max per shift.</p>\n                    )}\n                    <p className=\"text-xs\" style={{ color: 'var(--subtle)' }}>\n                      Floor division: owed = hourlyRate × attested seconds / 3600. At most 0.000001 USDC favors the employer.\n                    </p>\n                  </div>\n                )}\n\n                {/* Errors */}\n                {(approveErr || createErr) && (\n                  <div className=\"rounded-xl p-3 flex items-start gap-2 text-sm\" style={{ background: '#fef2f2', border: '1px solid #fca5a5' }}>\n                    <XCircle className=\"size-4 shrink-0 mt-0.5\" style={{ color: 'var(--danger)' }} />\n                    <span style={{ color: '#991b1b' }}>{approveErr ?? createErr}</span>\n                  </div>\n                )}\n\n                {/* Success */}\n                {createPhase === 'done' && newShiftId && (\n                  <div className=\"rounded-xl p-4 flex items-start gap-3\" style={{ background: '#f0fdf4', border: '1px solid #86efac' }}>\n                    <CheckCircle2 className=\"size-5 shrink-0 mt-0.5\" style={{ color: 'var(--success)' }} />\n                    <div>\n                      <p className=\"font-semibold text-sm\" style={{ color: 'var(--success)' }}>Shift #{newShiftId} created</p>\n                      {createTx && (\n                        <a href={explorerTx(createTx)} target=\"_blank\" rel=\"noopener noreferrer\" className=\"text-xs mt-1 inline-flex items-center gap-1 hover:underline\" style={{ color: '#166534' }}>\n                          View tx <ExternalLink className=\"size-3\" />\n                        </a>\n                      )}\n                      <div className=\"flex gap-2 mt-2\">\n                        <button onClick={() => navigate(`/shift/${newShiftId}`)} className=\"text-xs font-semibold hover:underline\" style={{ color: 'var(--accent-hover)' }}>\n                          Open receipt\n                        </button>\n                        <span style={{ color: 'var(--border-strong)' }}>·</span>\n                        <button onClick={resetCreateForm} className=\"text-xs font-semibold hover:underline\" style={{ color: 'var(--muted)' }}>\n                          Create another\n                        </button>\n                      </div>\n                    </div>\n                  </div>\n                )}\n\n                {/* Action button */}\n                {createPhase !== 'done' && (\n                  <button\n                    onClick={handleSimulate}\n                    disabled={!isValidForm || wrongChain || approvePhase === 'signing' || approvePhase === 'waiting' || createPhase === 'signing' || createPhase === 'waiting' || approvePhase === 'simulating'}\n                    className=\"w-full flex items-center justify-center gap-2 rounded-2xl py-3 text-sm font-semibold text-white transition-all hover:scale-[1.01] active:scale-[0.99] disabled:opacity-40 disabled:cursor-not-allowed\"\n                    style={{ background: 'var(--accent)' }}\n                  >\n                    {(approvePhase === 'simulating') && <><Loader2 className=\"size-4 animate-spin\" /> Checking…</>}\n                    {(approvePhase === 'signing')    && <><Loader2 className=\"size-4 animate-spin\" /> Approving USDC…</>}\n                    {(approvePhase === 'waiting')    && <><Loader2 className=\"size-4 animate-spin\" /> Waiting for approval…</>}\n                    {(approvePhase === 'done' && createPhase === 'signing') && <><Loader2 className=\"size-4 animate-spin\" /> Creating shift…</>}\n                    {(approvePhase === 'done' && createPhase === 'waiting') && <><Loader2 className=\"size-4 animate-spin\" /> Confirming…</>}\n                    {(approvePhase === 'idle' || approvePhase === 'error') && 'Approve USDC + Create Shift'}\n                  </button>\n                )}\n              </div>\n            </section>\n          </NetworkGuard>\n\n          {/* Actions on existing shifts */}\n          <section className=\"rounded-2xl p-5 space-y-4\" style={{ background: 'var(--surface-strong)', border: '1px solid var(--border)' }}>\n            <h2 className=\"font-semibold text-sm\" style={{ color: 'var(--ink)' }}>Manage a Shift</h2>\n\n            <div>\n              <label className=\"text-xs font-medium mb-1 block\" style={{ color: 'var(--muted)' }}>Shift ID</label>\n              <input\n                type=\"number\"\n                value={actionShiftId}\n                onChange={e => setActionShiftId(e.target.value)}\n                placeholder=\"e.g. 1\"\n                className=\"w-full rounded-xl px-3 py-2.5 text-sm tabular-nums outline-none\"\n                style={{ background: 'var(--surface-muted)', border: '1px solid var(--border)', color: 'var(--ink)' }}\n              />\n            </div>\n\n            {actionShift && Number(actionShift.status) > 0 && (\n              <div className=\"rounded-xl p-3 space-y-1.5 text-sm\" style={{ background: 'var(--surface-muted)', border: '1px solid var(--border)' }}>\n                <p className=\"font-semibold\" style={{ color: 'var(--ink)' }}>Shift #{actionShiftId} preview</p>\n                <p style={{ color: 'var(--muted)' }}>Status: {['None','Funded','Active','Awaiting Attestation','Attested','Claimed','Settled','Cancelled'][asStatus]}</p>\n                <p style={{ color: 'var(--muted)' }}>Employer: <span className=\"mono\">{shortAddr(actionShift.employer as string)}</span></p>\n                <p style={{ color: 'var(--muted)' }}>Worker: <span className=\"mono\">{shortAddr(actionShift.worker as string)}</span></p>\n                <p style={{ color: 'var(--muted)' }}>Escrow: <span className=\"tabular-nums\">{formatUsdc2(asEscrow)} USDC</span></p>\n                {!isMyShift && <p className=\"text-xs\" style={{ color: 'var(--danger)' }}>Your wallet is not the employer for this shift.</p>}\n              </div>\n            )}\n\n            <NetworkGuard>\n              {/* Attest */}\n              {canAttest && isMyShift && (\n                <div className=\"space-y-2\">\n                  <label className=\"text-xs font-medium block\" style={{ color: 'var(--muted)' }}>Attested hours (max {asMax / 3600}h)</label>\n                  <input\n                    type=\"number\"\n                    inputMode=\"decimal\"\n                    value={attestHours}\n                    onChange={e => setAttestHours(e.target.value)}\n                    placeholder=\"0.00\"\n                    min=\"0\"\n                    max={asMax / 3600}\n                    step=\"0.01\"\n                    className=\"w-full rounded-xl px-3 py-2.5 text-sm tabular-nums outline-none\"\n                    style={{ background: 'var(--surface-muted)', border: '1px solid var(--border)', color: 'var(--ink)' }}\n                  />\n                  {attestSecs > 0 && (\n                    <p className=\"text-xs tabular-nums\" style={{ color: 'var(--muted)' }}>\n                      {secondsToDisplay(attestSecs)} ({attestSecs}s) &rarr; owed: {formatUsdc2(attestRaw)} USDC\n                    </p>\n                  )}\n                  <TxButton\n                    label=\"Attest hours\"\n                    address={CONTRACT_ADDRESS}\n                    abi={ABI}\n                    functionName=\"attest\"\n                    args={[BigInt(actionShiftId), attestSecs as unknown as number]}\n                    disabled={attestSecs < 0 || attestSecs > asMax}\n                    confirmCard={\n                      <div className=\"space-y-2 text-sm\">\n                        <Row label=\"Action\" value=\"Attest hours\" />\n                        <Row label=\"Shift ID\" value={`#${actionShiftId}`} />\n                        <Row label=\"Attested\" value={`${secondsToDisplay(attestSecs)} (${attestSecs}s)`} />\n                        <Row label=\"Worker owed\" value={`${formatUsdc2(attestRaw)} USDC`} />\n                        <Row label=\"Residual (refundable)\" value={`${formatUsdc2(asEscrow - attestRaw)} USDC`} />\n                        <Row label=\"Contract\" value={<span className=\"mono\">{shortAddr(CONTRACT_ADDRESS)}</span>} />\n                      </div>\n                    }\n                    onSuccess={(h) => { recordTx(actionShiftId, 'attest', h); refetchActionShift() }}\n                  />\n                </div>\n              )}\n\n              {/* Refund unused */}\n              {canRefund && (\n                <TxButton\n                  label={`Refund unused (${formatUsdc2(asEscrow - asOwed)} USDC)`}\n                  address={CONTRACT_ADDRESS}\n                  abi={ABI}\n                  functionName=\"refundUnused\"\n                  args={[BigInt(actionShiftId)]}\n                  confirmCard={\n                    <div className=\"space-y-2 text-sm\">\n                      <Row label=\"Action\" value=\"Refund unused escrow\" />\n                      <Row label=\"Shift ID\" value={`#${actionShiftId}`} />\n                      <Row label=\"Refund amount\" value={`${formatUsdc2(asEscrow - asOwed)} USDC`} />\n                      <Row label=\"Recipient\" value=\"Employer (always)\" />\n                      <Row label=\"Contract\" value={<span className=\"mono\">{shortAddr(CONTRACT_ADDRESS)}</span>} />\n                    </div>\n                  }\n                  onSuccess={(h) => { recordTx(actionShiftId, 'refundUnused', h); refetchActionShift() }}\n                />\n              )}\n\n              {/* Cancel */}\n              {canCancel && isMyShift && (\n                <TxButton\n                  label={`Cancel shift (refund ${formatUsdc2(asEscrow)} USDC)`}\n                  address={CONTRACT_ADDRESS}\n                  abi={ABI}\n                  functionName=\"cancel\"\n                  args={[BigInt(actionShiftId)]}\n                  confirmCard={\n                    <div className=\"space-y-2 text-sm\">\n                      <Row label=\"Action\" value=\"Cancel shift (before clock-in)\" />\n                      <Row label=\"Shift ID\" value={`#${actionShiftId}`} />\n                      <Row label=\"Full escrow returned\" value={`${formatUsdc2(asEscrow)} USDC`} />\n                      <Row label=\"Recipient\" value=\"Employer wallet\" />\n                      <Row label=\"Worker paid\" value=\"Nothing (shift cancelled)\" />\n                      <Row label=\"Contract\" value={<span className=\"mono\">{shortAddr(CONTRACT_ADDRESS)}</span>} />\n                    </div>\n                  }\n                  onSuccess={(h) => { recordTx(actionShiftId, 'cancel', h); refetchActionShift() }}\n                />\n              )}\n\n              {actionShift && Number(actionShift.status) > 0 && !canAttest && !canRefund && !canCancel && (\n                <p className=\"text-sm text-center py-2\" style={{ color: 'var(--subtle)' }}>\n                  No employer actions available for this shift status.\n                </p>\n              )}\n            </NetworkGuard>\n          </section>\n\n          {/* Shift list */}\n          <section>\n            <div className=\"flex items-center justify-between mb-3\">\n              <h2 className=\"font-semibold text-sm\" style={{ color: 'var(--ink)' }}>Your Shifts (this browser)</h2>\n              <button onClick={() => setCreatedIds(getCreatedIds())} className=\"flex items-center gap-1 text-xs\" style={{ color: 'var(--accent-hover)' }}>\n                <RefreshCw className=\"size-3\" /> Refresh\n              </button>\n            </div>\n\n            {/* Manual open */}\n            <div className=\"flex gap-2 mb-3\">\n              <input\n                type=\"number\"\n                value={manualId}\n                onChange={e => setManualId(e.target.value)}\n                placeholder=\"Open shift by ID…\"\n                className=\"flex-1 rounded-xl px-3 py-2 text-sm outline-none\"\n                style={{ background: 'var(--surface-muted)', border: '1px solid var(--border)', color: 'var(--ink)' }}\n              />\n              <button\n                onClick={() => { if (manualId) { addCreatedId(manualId); setCreatedIds(getCreatedIds()); setManualId('') } }}\n                disabled={!manualId}\n                className=\"px-4 py-2 rounded-xl text-sm font-semibold text-white disabled:opacity-40\"\n                style={{ background: 'var(--accent)' }}\n              >\n                Track\n              </button>\n            </div>\n\n            {createdIds.length === 0 ? (\n              <div className=\"rounded-2xl p-6 text-center\" style={{ background: 'var(--surface-muted)', border: '1px solid var(--border)' }}>\n                <AlertCircle className=\"size-8 mx-auto mb-2\" style={{ color: 'var(--subtle)' }} />\n                <p className=\"text-sm\" style={{ color: 'var(--muted)' }}>No shifts tracked in this browser yet.</p>\n                <p className=\"text-xs mt-1\" style={{ color: 'var(--subtle)' }}>Shifts you create will appear here. Use \"Open by ID\" if you've cleared your cache.</p>\n              </div>\n            ) : (\n              <div className=\"space-y-2\">\n                {[...createdIds].reverse().map(id => (\n                  <ShiftCard key={id} shiftId={id} onNavigate={navigate} />\n                ))}\n              </div>\n            )}\n          </section>\n        </>\n      )}\n\n      {/* Confirm overlay for create */}\n      {showCreateConfirm && (\n        <div className=\"fixed inset-0 z-50 flex items-end sm:items-center justify-center p-4\">\n          <div className=\"absolute inset-0 bg-black/30 backdrop-blur-sm\" onClick={() => { setShowCreateConfirm(false); setApprovePhase('idle') }} />\n          <div className=\"relative w-full max-w-md rounded-3xl overflow-hidden\" style={{ background: 'rgba(255,255,255,0.95)', backdropFilter: 'blur(40px)' }}>\n            <div className=\"h-1\" style={{ background: 'linear-gradient(90deg, #1061a6, #122d45)' }} />\n            <div className=\"p-6\">\n              <h3 className=\"font-semibold text-sm mb-4\" style={{ color: 'var(--ink)' }}>Confirm: Approve USDC + Create Shift</h3>\n              <div className=\"space-y-2 text-sm\">\n                <Row label=\"Step 1\" value=\"Approve exact USDC\" />\n                <Row label=\"Approval amount\" value={<span className=\"tabular-nums\">{formatUsdc2(escrowRaw)} USDC</span>} />\n                <Row label=\"Spender\" value={<span className=\"mono\">{shortAddr(CONTRACT_ADDRESS)}</span>} />\n                <Row label=\"Step 2\" value=\"Create shift\" />\n                <Row label=\"Worker\" value={<span className=\"mono\">{shortAddr(workerAddr)}</span>} />\n                <Row label=\"Rate\" value={<span className=\"tabular-nums\">{rateInput} USDC/hr</span>} />\n                <Row label=\"Duration\" value={`${secondsToDisplay(maxSeconds)} (${maxSeconds}s)`} />\n                <Row label=\"Escrow pulled\" value={<span className=\"tabular-nums\" style={{ color: 'var(--danger)' }}>{formatUsdc2(escrowRaw)} USDC</span>} />\n                <Row label=\"Network\" value=\"Arc Testnet (5042002)\" />\n              </div>\n              <div className=\"flex gap-3 mt-5\">\n                <button onClick={() => { setShowCreateConfirm(false); setApprovePhase('idle') }} className=\"flex-1 py-2.5 rounded-xl text-sm font-semibold border\" style={{ borderColor: 'var(--border-strong)', color: 'var(--muted)' }}>\n                  Cancel\n                </button>\n                <button onClick={handleApproveAndCreate} className=\"flex-1 py-2.5 rounded-xl text-sm font-semibold text-white\" style={{ background: 'var(--accent)' }}>\n                  Sign both\n                </button>\n              </div>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  )\n}\n\n// Simple label-value row\nfunction Row({ label, value }: { label: string; value: React.ReactNode }) {\n  return (\n    <div className=\"flex items-start justify-between gap-4\">\n      <span style={{ color: 'var(--muted)' }}>{label}</span>\n      <span className=\"text-right font-medium\" style={{ color: 'var(--ink)' }}>{value}</span>\n    </div>\n  )\n}\n","totalLines":580}}
