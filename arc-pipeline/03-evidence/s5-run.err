{"kind":"data","event":{"type":"sandbox_step","step":"file_written","status":"running","path":"/home/user/app/src/lib/router.ts","toolCallId":"01a17b48-dbd9-7329-a0a8-6f9285fa58a4"}}
{"kind":"data","event":{"type":"file_write_streaming","toolCallId":"01a17b48-dbd9-7329-a0a8-6f9285fa58a4","path":"/home/user/app/src/lib/router.ts","status":"running","chunk":"/**\n * Tiny path router — no dependency. Uses History API.\n * Vite dev server handles unknown paths via index.html fallback.\n */\nimport { useState, useEffect, useCallback } from 'react'\n\nexport function usePath(): [string, (p: string) => void] {\n  const [path, setPath] = useState(() => window.location.pathname)\n\n  useEffect(() => {\n    const onPop = () => setPath(window.location.pathname)\n    window.addEventListener('popstate', onPop)\n    return () => window.removeEventListener('popstate', onPop)\n  }, [])\n\n  const navigate = useCallback((p: string) => {\n    window.history.pushState(null, '', p)\n    setPath(p)\n  }, [])\n\n  return [path, navigate]\n}\n\n/** Extract a segment: matchPath('/shift/:id', '/shift/42') => { id: '42' } */\nexport function matchPath(pattern: string, path: string): Record<string, string> | null {\n  const patParts = pattern.split('/')\n  const pathParts = path.split('/')\n  if (patParts.length !== pathParts.length) return null\n  const params: Record<string, string> = {}\n  for (let i = 0; i < patParts.length; i++) {\n    if (patParts[i].startsWith(':')) {\n      params[patParts[i].slice(1)] = decodeURIComponent(pathParts[i])\n    } else if (patParts[i] !== pathParts[i]) {\n      return null\n    }\n  }\n  return params\n}\n","totalLines":39}}
