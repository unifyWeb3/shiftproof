{"kind":"data","event":{"type":"sandbox_step","step":"file_written","status":"running","path":"/home/user/app/src/lib/storage.ts","toolCallId":"01a17b48-cae8-72e4-99c0-415a60464bcb"}}
{"kind":"data","event":{"type":"file_write_streaming","toolCallId":"01a17b48-cae8-72e4-99c0-415a60464bcb","path":"/home/user/app/src/lib/storage.ts","status":"running","chunk":"/**\n * localStorage helpers — convenience cache only.\n * Clearing localStorage loses convenience, not funds or shift records.\n * No PII is stored here.\n */\nimport { CHAIN_ID, CONTRACT_ADDRESS } from './contract'\n\nconst pfx = (suffix: string) =>\n  `shiftproof:${CHAIN_ID}:${CONTRACT_ADDRESS.toLowerCase()}:${suffix}`\n\nexport const KEYS = {\n  created:  pfx('created'),    // shift IDs created by this browser\n  assigned: pfx('assigned'),   // shift IDs assigned to this browser (worker)\n  labels:   pfx('labels'),     // optional local labels {id: label} — NO personal data\n  lastRead: pfx('lastRead'),   // last block scanned\n  txHashes: pfx('txHashes'),   // {shiftId: {step: hash}}\n}\n\nfunction safeGet<T>(key: string, fallback: T): T {\n  try {\n    const raw = localStorage.getItem(key)\n    return raw ? (JSON.parse(raw) as T) : fallback\n  } catch {\n    return fallback\n  }\n}\n\nfunction safeSet(key: string, val: unknown) {\n  try { localStorage.setItem(key, JSON.stringify(val)) } catch { /* ignore */ }\n}\n\nexport function getCreatedIds(): string[] {\n  return safeGet<string[]>(KEYS.created, [])\n}\nexport function addCreatedId(id: string) {\n  const ids = getCreatedIds()\n  if (!ids.includes(id)) safeSet(KEYS.created, [...ids, id])\n}\n\nexport function getAssignedIds(): string[] {\n  return safeGet<string[]>(KEYS.assigned, [])\n}\nexport function addAssignedId(id: string) {\n  const ids = getAssignedIds()\n  if (!ids.includes(id)) safeSet(KEYS.assigned, [...ids, id])\n}\n\nexport function getLabels(): Record<string, string> {\n  return safeGet<Record<string, string>>(KEYS.labels, {})\n}\nexport function setLabel(id: string, label: string) {\n  const labels = getLabels()\n  safeSet(KEYS.labels, { ...labels, [id]: label.slice(0, 80) })\n}\n\nexport function getLastReadBlock(): bigint {\n  const raw = safeGet<string | null>(KEYS.lastRead, null)\n  return raw ? BigInt(raw) : 0n\n}\nexport function setLastReadBlock(block: bigint) {\n  safeSet(KEYS.lastRead, block.toString())\n}\n\n// Tx hash records: {shiftId: {create: hash, clockIn: hash, ...}}\nexport type TxHashes = Partial<Record<\n  'create' | 'approve' | 'clockIn' | 'clockOut' | 'attest' | 'claim' | 'refundUnused' | 'cancel',\n  string\n>>\nexport function getTxHashes(shiftId: string): TxHashes {\n  const all = safeGet<Record<string, TxHashes>>(KEYS.txHashes, {})\n  return all[shiftId] ?? {}\n}\nexport function recordTx(shiftId: string, step: keyof TxHashes, hash: string) {\n  const all = safeGet<Record<string, TxHashes>>(KEYS.txHashes, {})\n  all[shiftId] = { ...(all[shiftId] ?? {}), [step]: hash }\n  safeSet(KEYS.txHashes, all)\n}\n","totalLines":78}}
