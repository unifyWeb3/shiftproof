{"kind":"data","event":{"type":"file_write_streaming","toolCallId":"01a17b49-5c87-74a4-a607-9214d1380aa4","path":"/home/user/app/src/components/StatusBadge.tsx","status":"running","chunk":"import { STATUS_LABELS, STATUS_COLORS } from '../lib/contract'\n\ninterface StatusBadgeProps {\n  status: number\n  size?: 'sm' | 'md'\n}\n\nexport default function StatusBadge({ status, size = 'md' }: StatusBadgeProps) {\n  const label = STATUS_LABELS[status] ?? 'Unknown'\n  const color = STATUS_COLORS[status] ?? '#8a849c'\n\n  return (\n    <span\n      className={`inline-flex items-center font-semibold rounded-full tabular-nums ${size === 'sm' ? 'px-2 py-0.5 text-xs' : 'px-3 py-1 text-sm'}`}\n      style={{\n        color,\n        background: `${color}18`,\n        border: `1px solid ${color}30`,\n      }}\n    >\n      {label}\n    </span>\n  )\n}\n","totalLines":25}}
