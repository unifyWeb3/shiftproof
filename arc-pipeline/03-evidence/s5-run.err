{"kind":"data","event":{"type":"sandbox_step","step":"file_written","status":"running","path":"/home/user/app/src/components/NetworkGuard.tsx","toolCallId":"01a17b49-514b-77d1-9e4c-e3ac5ea2adce"}}
{"kind":"data","event":{"type":"file_write_streaming","toolCallId":"01a17b49-514b-77d1-9e4c-e3ac5ea2adce","path":"/home/user/app/src/components/NetworkGuard.tsx","status":"running","chunk":"import { useAccount, useSwitchChain } from 'wagmi'\nimport { AlertTriangle, ArrowRightLeft } from 'lucide-react'\nimport { CHAIN_ID } from '../lib/contract'\nimport type { ReactNode } from 'react'\n\ninterface NetworkGuardProps {\n  children: ReactNode\n}\n\nexport default function NetworkGuard({ children }: NetworkGuardProps) {\n  const { isConnected, chainId } = useAccount()\n  const { switchChain, isPending } = useSwitchChain()\n\n  if (!isConnected) return <>{children}</>\n\n  const onWrongChain = chainId !== CHAIN_ID\n\n  if (onWrongChain) {\n    return (\n      <div\n        className=\"rounded-2xl p-5 mb-6 flex flex-col sm:flex-row items-start sm:items-center gap-4\"\n        style={{\n          background: '#fef3c7',\n          border: '1px solid #fde047',\n        }}\n      >\n        <div className=\"flex items-center gap-2 flex-1\">\n          <AlertTriangle className=\"size-5 shrink-0\" style={{ color: '#92400e' }} />\n          <div>\n            <p className=\"font-semibold text-sm\" style={{ color: '#92400e' }}>\n              Wrong network\n            </p>\n            <p className=\"text-xs mt-0.5\" style={{ color: '#a16207' }}>\n              Your wallet is on chain {chainId ?? '?'}. ShiftProof requires Arc Testnet (chain {CHAIN_ID}).\n              Writes are disabled until you switch.\n            </p>\n          </div>\n        </div>\n        <button\n          onClick={() => switchChain({ chainId: CHAIN_ID as 5042002 })}\n          disabled={isPending}\n          className=\"flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-semibold whitespace-nowrap transition-all hover:scale-[1.02] active:scale-[0.98] disabled:opacity-50\"\n          style={{ background: '#92400e', color: '#fff' }}\n        >\n          <ArrowRightLeft className=\"size-4\" />\n          {isPending ? 'Switching…' : 'Switch to Arc Testnet'}\n        </button>\n      </div>\n    )\n  }\n\n  return <>{children}</>\n}\n\n/** Hook: returns true when writes should be blocked */\nexport function useWrongChain(): boolean {\n  const { isConnected, chainId } = useAccount()\n  return isConnected && chainId !== CHAIN_ID\n}\n","totalLines":60}}
