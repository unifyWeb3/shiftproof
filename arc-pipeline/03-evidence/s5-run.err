{"kind":"data","event":{"type":"sandbox_step","step":"file_written","status":"running","path":"/home/user/app/src/components/ShiftCard.tsx","toolCallId":"01a17b49-cf3f-7172-9bbb-ee8b8a2fce7c"}}
{"kind":"data","event":{"type":"file_write_streaming","toolCallId":"01a17b49-cf3f-7172-9bbb-ee8b8a2fce7c","path":"/home/user/app/src/components/ShiftCard.tsx","status":"running","chunk":"/**\n * Compact shift summary card used in employer and worker dashboards.\n */\nimport { useReadContract } from 'wagmi'\nimport { ExternalLink, ChevronRight, Clock } from 'lucide-react'\nimport { ABI, CONTRACT_ADDRESS, CHAIN_ID, explorerTx } from '../lib/contract'\nimport { formatUsdc2, secondsToDisplay, shortAddr, shortTimestamp } from '../lib/format'\nimport { getTxHashes } from '../lib/storage'\nimport StatusBadge from './StatusBadge'\n\ninterface ShiftCardProps {\n  shiftId: string\n  onNavigate: (path: string) => void\n}\n\nexport default function ShiftCard({ shiftId, onNavigate }: ShiftCardProps) {\n  const { data: shift, isLoading } = useReadContract({\n    address: CONTRACT_ADDRESS,\n    abi: ABI,\n    functionName: 'getShift',\n    args: [BigInt(shiftId)],\n    chainId: CHAIN_ID,\n  })\n\n  const txHashes = getTxHashes(shiftId)\n\n  if (isLoading) {\n    return (\n      <div\n        className=\"rounded-2xl p-4 animate-pulse\"\n        style={{ background: 'var(--surface-muted)', border: '1px solid var(--border)' }}\n      >\n        <div className=\"h-4 w-24 rounded bg-slate-200 mb-2\" />\n        <div className=\"h-3 w-40 rounded bg-slate-200\" />\n      </div>\n    )\n  }\n\n  if (!shift || Number(shift.status) === 0) {\n    return (\n      <div\n        className=\"rounded-2xl p-4\"\n        style={{ background: 'var(--surface-muted)', border: '1px solid var(--border)', color: 'var(--subtle)' }}\n      >\n        <p className=\"text-sm\">Shift #{shiftId} — not found</p>\n      </div>\n    )\n  }\n\n  const status = Number(shift.status)\n  const escrow = shift.escrow as bigint\n  const owed = shift.owed as bigint\n  const hourlyRate = shift.hourlyRate as bigint\n  const maxSeconds = Number(shift.maxSeconds)\n  const createdAt = Number(shift.createdAt)\n  const startedAt = Number(shift.startedAt)\n\n  return (\n    <button\n      onClick={() => onNavigate(`/shift/${shiftId}`)}\n      className=\"w-full rounded-2xl p-4 text-left transition-all hover:scale-[1.005] hover:shadow-sm\"\n      style={{ background: 'var(--surface-strong)', border: '1px solid var(--border)' }}\n    >\n      <div className=\"flex items-center justify-between gap-3 mb-2\">\n        <div className=\"flex items-center gap-2\">\n          <span className=\"display font-semibold text-sm\" style={{ color: 'var(--ink)' }}>\n            Shift #{shiftId}\n          </span>\n          <StatusBadge status={status} size=\"sm\" />\n        </div>\n        <ChevronRight className=\"size-4 shrink-0\" style={{ color: 'var(--subtle)' }} />\n      </div>\n\n      <div className=\"grid grid-cols-2 gap-2 text-xs mt-2\" style={{ color: 'var(--muted)' }}>\n        <span>Rate: <span className=\"font-semibold tabular-nums\" style={{ color: 'var(--ink-2)' }}>{formatUsdc2(hourlyRate)} USDC/hr</span></span>\n        <span>Max: <span className=\"font-semibold\" style={{ color: 'var(--ink-2)' }}>{secondsToDisplay(maxSeconds)}</span></span>\n        <span>Escrow: <span className=\"font-semibold tabular-nums\" style={{ color: 'var(--ink-2)' }}>{formatUsdc2(escrow)} USDC</span></span>\n        {owed > 0n && <span>Owed: <span className=\"font-semibold tabular-nums\" style={{ color: 'var(--success)' }}>{formatUsdc2(owed)} USDC</span></span>}\n      </div>\n\n      <div className=\"flex items-center gap-3 mt-2 text-xs\" style={{ color: 'var(--subtle)' }}>\n        <span>W: <span className=\"mono\">{shortAddr(shift.worker as string)}</span></span>\n        {startedAt > 0 && (\n          <span className=\"flex items-center gap-1\">\n            <Clock className=\"size-3\" /> {shortTimestamp(createdAt)}\n          </span>\n        )}\n      </div>\n\n      {/* Quick tx links */}\n      {Object.entries(txHashes).length > 0 && (\n        <div className=\"mt-2 flex flex-wrap gap-2\">\n          {Object.entries(txHashes).map(([step, hash]) => (\n            <a\n              key={step}\n              href={explorerTx(hash as string)}\n              target=\"_blank\"\n              rel=\"noopener noreferrer\"\n              onClick={(e) => e.stopPropagation()}\n              className=\"inline-flex items-center gap-1 text-xs hover:underline\"\n              style={{ color: 'var(--accent-hover)' }}\n            >\n              {step} <ExternalLink className=\"size-3\" />\n            </a>\n          ))}\n        </div>\n      )}\n    </button>\n  )\n}\n","totalLines":111}}
