{"kind":"data","event":{"type":"sandbox_step","step":"file_written","status":"running","path":"/home/user/app/src/pages/Home.tsx","toolCallId":"01a17b4b-4925-77ff-8586-ae97f39bd862"}}
{"kind":"data","event":{"type":"file_write_streaming","toolCallId":"01a17b4b-4925-77ff-8586-ae97f39bd862","path":"/home/user/app/src/pages/Home.tsx","status":"running","chunk":"import { ShieldCheck, Briefcase, User, Search, ArrowRight } from 'lucide-react'\n\ninterface HomeProps { navigate: (p: string) => void }\n\nexport default function Home({ navigate }: HomeProps) {\n  return (\n    <div className=\"max-w-2xl mx-auto space-y-10\">\n      {/* Hero */}\n      <div className=\"text-center space-y-4 pt-4\">\n        <div\n          className=\"inline-flex size-16 items-center justify-center rounded-2xl mb-2\"\n          style={{ background: 'var(--accent)' }}\n        >\n          <ShieldCheck className=\"size-8 text-white\" />\n        </div>\n        <h1 className=\"display text-4xl font-bold\" style={{ color: 'var(--ink)', letterSpacing: '-0.03em' }}>\n          ShiftProof\n        </h1>\n        <p className=\"text-base max-w-md mx-auto\" style={{ color: 'var(--ink-2)' }}>\n          On-chain shift escrow and attestation. Employers fund shifts in USDC;\n          workers clock in and out; employers attest hours; workers claim their pay.\n          No admin. No fees beyond gas. No surprises.\n        </p>\n        <div\n          className=\"inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold\"\n          style={{ background: '#fef3c7', color: '#92400e', border: '1px solid #fde047' }}\n        >\n          Arc Testnet — not real funds\n        </div>\n      </div>\n\n      {/* Role cards */}\n      <div className=\"grid sm:grid-cols-3 gap-4\">\n        <RoleCard\n          icon={<Briefcase className=\"size-6\" />}\n          title=\"I'm an Employer\"\n          desc=\"Fund a shift in USDC, attest hours worked, refund unused escrow.\"\n          cta=\"Employer Dashboard\"\n          onClick={() => navigate('/employer')}\n          accent=\"#1061a6\"\n        />\n        <RoleCard\n          icon={<User className=\"size-6\" />}\n          title=\"I'm a Worker\"\n          desc=\"Clock in/out, wait for attestation, claim your pay.\"\n          cta=\"Worker Dashboard\"\n          onClick={() => navigate('/worker')}\n          accent=\"var(--success)\"\n        />\n        <RoleCard\n          icon={<Search className=\"size-6\" />}\n          title=\"Verify a Shift\"\n          desc=\"Read any shift's public receipt by ID — no wallet needed.\"\n          cta=\"Open Receipt\"\n          onClick={() => navigate('/shift/1')}\n          accent=\"#7c3aed\"\n        />\n      </div>\n\n      {/* How it works */}\n      <section className=\"rounded-2xl p-6 space-y-4\" style={{ background: 'var(--surface-strong)', border: '1px solid var(--border)' }}>\n        <h2 className=\"display font-semibold text-lg\" style={{ color: 'var(--ink)' }}>How it works</h2>\n        <ol className=\"space-y-3\">\n          {[\n            { step: '1', title: 'Employer creates a shift', desc: 'Sets the worker address, hourly rate, and max hours. Exact USDC is pulled into the contract.' },\n            { step: '2', title: 'Worker clocks in/out', desc: 'Optional timer creates an onchain audit trail. The employer can also attest a stalled shift directly.' },\n            { step: '3', title: 'Employer attests hours', desc: 'The employer sets the payable seconds. Owed USDC is computed and locked.' },\n            { step: '4', title: 'Worker claims pay', desc: 'Worker calls claim; exact owed USDC transfers to their wallet.' },\n            { step: '5', title: 'Residual is refunded', desc: 'Anyone calls refundUnused to return leftover escrow to the employer.' },\n          ].map(({ step, title, desc }) => (\n            <li key={step} className=\"flex items-start gap-3\">\n              <span\n                className=\"shrink-0 size-6 rounded-full flex items-center justify-center text-xs font-bold text-white\"\n                style={{ background: 'var(--accent)' }}\n              >\n                {step}\n              </span>\n              <div>\n                <p className=\"font-semibold text-sm\" style={{ color: 'var(--ink)' }}>{title}</p>\n                <p className=\"text-sm mt-0.5\" style={{ color: 'var(--muted)' }}>{desc}</p>\n              </div>\n            </li>\n          ))}\n        </ol>\n      </section>\n\n      {/* Transparency */}\n      <div className=\"grid sm:grid-cols-3 gap-3\">\n        {[\n          { label: 'No admin', sub: 'No owner, pause, or upgrade function' },\n          { label: 'No fees', sub: 'Only standard network gas' },\n          { label: 'Exact approval', sub: 'Escrow amount only, no unlimited allowance' },\n        ].map(({ label, sub }) => (\n          <div key={label} className=\"rounded-xl p-4\" style={{ background: 'var(--surface-muted)', border: '1px solid var(--border)' }}>\n            <p className=\"font-semibold text-sm\" style={{ color: 'var(--ink)' }}>{label}</p>\n            <p className=\"text-xs mt-0.5\" style={{ color: 'var(--subtle)' }}>{sub}</p>\n          </div>\n        ))}\n      </div>\n    </div>\n  )\n}\n\nfunction RoleCard({\n  icon, title, desc, cta, onClick, accent,\n}: {\n  icon: React.ReactNode\n  title: string\n  desc: string\n  cta: string\n  onClick: () => void\n  accent: string\n}) {\n  return (\n    <button\n      onClick={onClick}\n      className=\"rounded-2xl p-5 text-left flex flex-col gap-3 transition-all hover:scale-[1.02] hover:shadow-md\"\n      style={{ background: 'var(--surface-strong)', border: '1px solid var(--border)' }}\n    >\n      <div className=\"size-10 rounded-xl flex items-center justify-center\" style={{ background: `${accent}18`, color: accent }}>\n        {icon}\n      </div>\n      <div>\n        <p className=\"font-semibold text-sm\" style={{ color: 'var(--ink)' }}>{title}</p>\n        <p className=\"text-xs mt-1\" style={{ color: 'var(--muted)' }}>{desc}</p>\n      </div>\n      <div className=\"flex items-center gap-1 text-xs font-semibold mt-auto\" style={{ color: accent }}>\n        {cta} <ArrowRight className=\"size-3\" />\n      </div>\n    </button>\n  )\n}\n","totalLines":133}}
