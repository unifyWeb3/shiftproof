{"kind":"data","event":{"type":"file_write_streaming","toolCallId":"01a17b49-3976-7399-b4be-7434fd8ad87a","path":"/home/user/app/src/components/Layout.tsx","status":"running","chunk":"import { type ReactNode } from 'react'\nimport { ConnectKitButton } from 'connectkit'\nimport { ShieldCheck, ExternalLink } from 'lucide-react'\nimport { CONTRACT_ADDRESS, CHAIN_ID, EXPLORER_BASE, explorerAddr } from '../lib/contract'\nimport { shortAddr } from '../lib/format'\n\ninterface LayoutProps {\n  children: ReactNode\n  navigate: (p: string) => void\n  path: string\n}\n\nconst NAV_LINKS = [\n  { label: 'Home',     href: '/' },\n  { label: 'Employer', href: '/employer' },\n  { label: 'Worker',   href: '/worker' },\n  { label: 'Verify',   href: '/proof' },\n  { label: 'Help',     href: '/help' },\n]\n\nexport default function Layout({ children, navigate, path }: LayoutProps) {\n  return (\n    <div className=\"min-h-dvh flex flex-col\">\n      {/* Nav */}\n      <header\n        className=\"sticky top-0 z-40 border-b\"\n        style={{\n          background: 'rgba(255,255,255,0.85)',\n          backdropFilter: 'blur(20px) saturate(180%)',\n          WebkitBackdropFilter: 'blur(20px) saturate(180%)',\n          borderColor: 'var(--border)',\n        }}\n      >\n        <div className=\"max-w-5xl mx-auto px-4 h-14 flex items-center justify-between gap-4\">\n          {/* Logo */}\n          <button\n            onClick={() => navigate('/')}\n            className=\"flex items-center gap-2 shrink-0\"\n          >\n            <div\n              className=\"size-7 rounded-lg flex items-center justify-center\"\n              style={{ background: 'var(--accent)' }}\n            >\n              <ShieldCheck className=\"size-4 text-white\" />\n            </div>\n            <span className=\"display font-700 text-sm hidden sm:block\" style={{ color: 'var(--ink)' }}>\n              ShiftProof\n            </span>\n          </button>\n\n          {/* Nav links */}\n          <nav className=\"flex items-center gap-1 overflow-x-auto\">\n            {NAV_LINKS.map(({ label, href }) => (\n              <button\n                key={href}\n                onClick={() => navigate(href)}\n                className=\"px-3 py-1.5 rounded-lg text-sm font-medium whitespace-nowrap transition-colors\"\n                style={{\n                  color: path === href ? 'var(--accent)' : 'var(--muted)',\n                  background: path === href ? 'rgba(18,45,69,0.06)' : 'transparent',\n                }}\n              >\n                {label}\n              </button>\n            ))}\n          </nav>\n\n          {/* Wallet */}\n          <div className=\"shrink-0\">\n            <ConnectKitButton />\n          </div>\n        </div>\n      </header>\n\n      {/* Testnet badge */}\n      <div className=\"text-center py-1.5 text-xs font-semibold\" style={{\n        background: '#fef3c7',\n        color: '#92400e',\n        letterSpacing: '0.05em',\n      }}>\n        TESTNET — Arc Testnet (Chain ID {CHAIN_ID}) — Not real funds\n      </div>\n\n      {/* Main */}\n      <main className=\"flex-1 max-w-5xl w-full mx-auto px-4 py-8\">\n        {children}\n      </main>\n\n      {/* Footer */}\n      <footer\n        className=\"border-t py-6 px-4 text-xs\"\n        style={{ borderColor: 'var(--border)', color: 'var(--subtle)' }}\n      >\n        <div className=\"max-w-5xl mx-auto flex flex-col sm:flex-row gap-3 items-start sm:items-center justify-between\">\n          <div className=\"flex flex-col gap-1\">\n            <span className=\"font-semibold\" style={{ color: 'var(--muted)' }}>ShiftProof V1</span>\n            <span>Chain ID: {CHAIN_ID} &middot; Arc Testnet</span>\n            <span className=\"mono\">\n              Contract:{' '}\n              <a\n                href={explorerAddr(CONTRACT_ADDRESS)}\n                target=\"_blank\"\n                rel=\"noopener noreferrer\"\n                className=\"hover:underline\"\n                style={{ color: 'var(--accent-hover)' }}\n              >\n                {shortAddr(CONTRACT_ADDRESS)}\n              </a>\n              {' '}&middot;{' '}\n              <a\n                href={EXPLORER_BASE}\n                target=\"_blank\"\n                rel=\"noopener noreferrer\"\n                className=\"hover:underline\"\n                style={{ color: 'var(--accent-hover)' }}\n              >\n                Explorer <ExternalLink className=\"inline size-3\" />\n              </a>\n            </span>\n          </div>\n          <div className=\"text-right\">\n            <div>No admin &middot; No upgrade &middot; No fees beyond gas</div>\n            <div className=\"mt-1\">\n              Source:{' '}\n              <a\n                href={explorerAddr(CONTRACT_ADDRESS)}\n                target=\"_blank\"\n                rel=\"noopener noreferrer\"\n                className=\"hover:underline\"\n                style={{ color: 'var(--accent-hover)' }}\n              >\n                On-chain\n              </a>\n            </div>\n          </div>\n        </div>\n      </footer>\n    </div>\n  )\n}\n","totalLines":141}}
