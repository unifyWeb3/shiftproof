{"kind":"data","event":{"type":"file_write_streaming","toolCallId":"01a17b4b-1116-72d0-bd2d-65f6de45e091","path":"/home/user/app/src/pages/Worker.tsx","status":"running","chunk":"import { useState, useEffect } from 'react'\nimport { useAccount, useReadContract } from 'wagmi'\nimport { ConnectKitButton } from 'connectkit'\nimport { AlertCircle, RefreshCw } from 'lucide-react'\nimport { ABI, CONTRACT_ADDRESS, CHAIN_ID } from '../lib/contract'\nimport { formatUsdc2, shortAddr } from '../lib/format'\nimport { getAssignedIds, addAssignedId, getTxHashes, recordTx } from '../lib/storage'\nimport NetworkGuard from '../components/NetworkGuard'\nimport { useWrongChain } from '../components/NetworkGuard'\nimport ShiftCard from '../components/ShiftCard'\nimport TxButton from '../components/TxButton'\nimport StatusBadge from '../components/StatusBadge'\n\ninterface WorkerProps { navigate: (p: string) => void }\n\nexport default function Worker({ navigate }: WorkerProps) {\n  const { address, isConnected } = useAccount()\n  const wrongChain = useWrongChain()\n  const [assignedIds, setAssignedIds] = useState<string[]>([])\n  const [manualId, setManualId] = useState('')\n  const [actionShiftId, setActionShiftId] = useState('')\n\n  useEffect(() => { setAssignedIds(getAssignedIds()) }, [])\n\n  const { data: actionShift, refetch: refetchShift } = useReadContract({\n    address: CONTRACT_ADDRESS, abi: ABI, functionName: 'getShift',\n    args: [BigInt(actionShiftId || '0')],\n    chainId: CHAIN_ID,\n    query: { enabled: !!actionShiftId && actionShiftId !== '0' },\n  })\n\n  const asStatus  = actionShift ? Number(actionShift.status)    : -1\n  const asEscrow  = actionShift ? (actionShift.escrow as bigint) : 0n\n  const asOwed    = actionShift ? (actionShift.owed   as bigint)  : 0n\n  const isWorker  = address && actionShift &&\n    (actionShift.worker as string).toLowerCase() === address.toLowerCase()\n\n  const canClockIn  = asStatus === 1\n  const canClockOut = asStatus === 2\n  const canClaim    = asStatus === 4 && asOwed > 0n\n\n  const txHashes = actionShiftId ? getTxHashes(actionShiftId) : {}\n\n  return (\n    <div className=\"space-y-8\">\n      <div>\n        <h1 className=\"display text-3xl font-bold\" style={{ color: 'var(--ink)', letterSpacing: '-0.02em' }}>\n          Worker Dashboard\n        </h1>\n        <p className=\"mt-1 text-sm\" style={{ color: 'var(--muted)' }}>\n          Clock in/out, track your shifts, and claim your pay.\n        </p>\n      </div>\n\n      {!isConnected && (\n        <div className=\"rounded-2xl p-8 flex flex-col items-center gap-4 text-center\" style={{ background: 'var(--surface-muted)', border: '1px solid var(--border)' }}>\n          <p className=\"text-sm\" style={{ color: 'var(--muted)' }}>Connect your worker wallet to manage shifts.</p>\n          <ConnectKitButton />\n        </div>\n      )}\n\n      {isConnected && (\n        <>\n          {/* Action panel */}\n          <NetworkGuard>\n            <section className=\"rounded-2xl p-5 space-y-4\" style={{ background: 'var(--surface-strong)', border: '1px solid var(--border)' }}>\n              <h2 className=\"font-semibold text-sm\" style={{ color: 'var(--ink)' }}>Open / Track Shift</h2>\n\n              <div className=\"flex gap-2\">\n                <input\n                  type=\"number\"\n                  value={actionShiftId}\n                  onChange={e => setActionShiftId(e.target.value)}\n                  placeholder=\"Shift ID…\"\n                  className=\"flex-1 rounded-xl px-3 py-2.5 text-sm tabular-nums outline-none\"\n                  style={{ background: 'var(--surface-muted)', border: '1px solid var(--border)', color: 'var(--ink)' }}\n                />\n                {actionShiftId && (\n                  <button onClick={() => { addAssignedId(actionShiftId); setAssignedIds(getAssignedIds()) }}\n                    className=\"px-3 py-2 rounded-xl text-sm font-semibold text-white\"\n                    style={{ background: 'var(--accent)' }}>\n                    Save\n                  </button>\n                )}\n              </div>\n\n              {/* Shift preview */}\n              {actionShift && Number(actionShift.status) > 0 && (\n                <div className=\"rounded-xl p-4 space-y-2 text-sm\" style={{ background: 'var(--surface-muted)', border: '1px solid var(--border)' }}>\n                  <div className=\"flex items-center justify-between\">\n                    <span className=\"font-semibold\" style={{ color: 'var(--ink)' }}>Shift #{actionShiftId}</span>\n                    <StatusBadge status={asStatus} size=\"sm\" />\n                  </div>\n                  <p style={{ color: 'var(--muted)' }}>Employer: <span className=\"mono\">{shortAddr(actionShift.employer as string)}</span></p>\n                  <p style={{ color: 'var(--muted)' }}>Worker: <span className=\"mono\">{shortAddr(actionShift.worker as string)}</span></p>\n                  <p style={{ color: 'var(--muted)' }}>Escrow: <span className=\"tabular-nums font-semibold\">{formatUsdc2(asEscrow)} USDC</span></p>\n                  {asOwed > 0n && <p style={{ color: 'var(--success)' }}>Owed to you: <span className=\"tabular-nums font-semibold\">{formatUsdc2(asOwed)} USDC</span></p>}\n                  {!isWorker && address && (\n                    <p className=\"text-xs\" style={{ color: 'var(--danger)' }}>Your wallet is not the worker for this shift.</p>\n                  )}\n                </div>\n              )}\n\n              {/* Actions */}\n              {actionShift && Number(actionShift.status) > 0 && isWorker && (\n                <div className=\"space-y-3\">\n                  {canClockIn && (\n                    <TxButton\n                      label=\"Clock In\"\n                      address={CONTRACT_ADDRESS}\n                      abi={ABI}\n                      functionName=\"clockIn\"\n                      args={[BigInt(actionShiftId)]}\n                      confirmCard={\n                        <div className=\"space-y-2 text-sm\">\n                          <ConfirmRow label=\"Action\" value=\"Clock in\" />\n                          <ConfirmRow label=\"Shift ID\" value={`#${actionShiftId}`} />\n                          <ConfirmRow label=\"Network\" value=\"Arc Testnet (5042002)\" />\n                          <ConfirmRow label=\"No USDC movement\" value=\"Timestamp recorded only\" />\n                        </div>\n                      }\n                      onSuccess={(h) => { recordTx(actionShiftId, 'clockIn', h); refetchShift() }}\n                    />\n                  )}\n\n                  {canClockOut && (\n                    <TxButton\n                      label=\"Clock Out\"\n                      address={CONTRACT_ADDRESS}\n                      abi={ABI}\n                      functionName=\"clockOut\"\n                      args={[BigInt(actionShiftId)]}\n                      confirmCard={\n                        <div className=\"space-y-2 text-sm\">\n                          <ConfirmRow label=\"Action\" value=\"Clock out\" />\n                          <ConfirmRow label=\"Shift ID\" value={`#${actionShiftId}`} />\n                          <ConfirmRow label=\"No USDC movement\" value=\"Timestamp recorded only\" />\n                        </div>\n                      }\n                      onSuccess={(h) => { recordTx(actionShiftId, 'clockOut', h); refetchShift() }}\n                    />\n                  )}\n\n                  {canClaim && (\n                    <TxButton\n                      label={`Claim ${formatUsdc2(asOwed)} USDC`}\n                      address={CONTRACT_ADDRESS}\n                      abi={ABI}\n                      functionName=\"claim\"\n                      args={[BigInt(actionShiftId)]}\n                      confirmCard={\n                        <div className=\"space-y-2 text-sm\">\n                          <ConfirmRow label=\"Action\" value=\"Claim pay\" />\n                          <ConfirmRow label=\"Shift ID\" value={`#${actionShiftId}`} />\n                          <ConfirmRow label=\"You receive\" value={<span className=\"tabular-nums font-semibold\" style={{ color: 'var(--success)' }}>{formatUsdc2(asOwed)} USDC</span>} />\n                          <ConfirmRow label=\"Recipient\" value={<span className=\"mono\">{shortAddr(address ?? '')}</span>} />\n                          <ConfirmRow label=\"Network\" value=\"Arc Testnet (5042002)\" />\n                        </div>\n                      }\n                      onSuccess={(h) => {\n                        recordTx(actionShiftId, 'claim', h)\n                        refetchShift()\n                        navigate(`/shift/${actionShiftId}`)\n                      }}\n                    />\n                  )}\n\n                  {asStatus === 4 && asOwed === 0n && (\n                    <p className=\"text-sm text-center py-2\" style={{ color: 'var(--subtle)' }}>\n                      Zero attestation — nothing to claim. Anyone can call refundUnused.\n                    </p>\n                  )}\n\n                  {[5, 6, 7].includes(asStatus) && (\n                    <div className=\"text-center py-2\">\n                      <p className=\"text-sm\" style={{ color: 'var(--success)' }}>\n                        {asStatus === 5 && 'Claimed — awaiting residual refund by employer.'}\n                        {asStatus === 6 && 'Settled — all done.'}\n                        {asStatus === 7 && 'Cancelled before you clocked in.'}\n                      </p>\n                      <button onClick={() => navigate(`/shift/${actionShiftId}`)} className=\"text-xs mt-1 hover:underline\" style={{ color: 'var(--accent-hover)' }}>\n                        View receipt\n                      </button>\n                    </div>\n                  )}\n\n                  {txHashes && Object.keys(txHashes).length > 0 && (\n                    <div className=\"pt-2\">\n                      <button onClick={() => navigate(`/shift/${actionShiftId}`)} className=\"text-xs hover:underline\" style={{ color: 'var(--accent-hover)' }}>\n                        View full receipt with all tx hashes\n                      </button>\n                    </div>\n                  )}\n                </div>\n              )}\n\n              {actionShift && Number(actionShift.status) > 0 && !isWorker && address && (\n                <p className=\"text-sm text-center\" style={{ color: 'var(--subtle)' }}>\n                  You are not the worker. You can still{' '}\n                  <button className=\"hover:underline\" style={{ color: 'var(--accent-hover)' }} onClick={() => navigate(`/shift/${actionShiftId}`)}>\n                    view the receipt\n                  </button>.\n                </p>\n              )}\n            </section>\n          </NetworkGuard>\n\n          {/* Assigned shifts list */}\n          <section>\n            <div className=\"flex items-center justify-between mb-3\">\n              <h2 className=\"font-semibold text-sm\" style={{ color: 'var(--ink)' }}>Assigned Shifts (this browser)</h2>\n              <button onClick={() => setAssignedIds(getAssignedIds())} className=\"flex items-center gap-1 text-xs\" style={{ color: 'var(--accent-hover)' }}>\n                <RefreshCw className=\"size-3\" /> Refresh\n              </button>\n            </div>\n\n            <div className=\"flex gap-2 mb-3\">\n              <input\n                type=\"number\"\n                value={manualId}\n                onChange={e => setManualId(e.target.value)}\n                placeholder=\"Add shift by ID…\"\n                className=\"flex-1 rounded-xl px-3 py-2 text-sm outline-none\"\n                style={{ background: 'var(--surface-muted)', border: '1px solid var(--border)', color: 'var(--ink)' }}\n              />\n              <button\n                onClick={() => { if (manualId) { addAssignedId(manualId); setAssignedIds(getAssignedIds()); setManualId('') } }}\n                disabled={!manualId}\n                className=\"px-4 py-2 rounded-xl text-sm font-semibold text-white disabled:opacity-40\"\n                style={{ background: 'var(--accent)' }}\n              >\n                Track\n              </button>\n            </div>\n\n            {assignedIds.length === 0 ? (\n              <div className=\"rounded-2xl p-6 text-center\" style={{ background: 'var(--surface-muted)', border: '1px solid var(--border)' }}>\n                <AlertCircle className=\"size-8 mx-auto mb-2\" style={{ color: 'var(--subtle)' }} />\n                <p className=\"text-sm\" style={{ color: 'var(--muted)' }}>No shifts tracked yet.</p>\n                <p className=\"text-xs mt-1\" style={{ color: 'var(--subtle)' }}>Ask your employer for the shift ID, then add it above.</p>\n              </div>\n            ) : (\n              <div className=\"space-y-2\">\n                {[...assignedIds].reverse().map(id => (\n                  <ShiftCard key={id} shiftId={id} onNavigate={navigate} />\n                ))}\n              </div>\n            )}\n          </section>\n        </>\n      )}\n    </div>\n  )\n}\n\nfunction ConfirmRow({ label, value }: { label: string; value: React.ReactNode }) {\n  return (\n    <div className=\"flex items-start justify-between gap-4\">\n      <span style={{ color: 'var(--muted)' }}>{label}</span>\n      <span className=\"text-right font-medium\" style={{ color: 'var(--ink)' }}>{value}</span>\n    </div>\n  )\n}\n","totalLines":264}}
