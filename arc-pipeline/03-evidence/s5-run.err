{"kind":"data","event":{"type":"file_write_streaming","toolCallId":"01a17b4c-b6ed-739a-b4e3-6abb75d15602","path":"/home/user/app/src/lib/format.ts","status":"running","chunk":"import { formatUnits } from 'viem'\nimport { CHAIN_ID } from './contract'\nimport { usdcDecimalsFor } from '@/onchain-money'\n\nconst USDC_DECIMALS = usdcDecimalsFor(CHAIN_ID)\n\n/** Format a raw USDC bigint to a display string like \"12.50\" */\nexport function fmtUsdc(raw: bigint, decimals?: number): string {\n  const d = decimals ?? USDC_DECIMALS\n  const s = formatUnits(raw, d)\n  const [int, frac = ''] = s.split('.')\n  return `${int}.${frac.padEnd(2, '0').slice(0, 2)}`\n}\n\n/** Format raw USDC with $ sign */\nexport function fmtUsd(raw: bigint, decimals?: number): string {\n  return `$${fmtUsdc(raw, decimals)}`\n}\n\n/** Duration in seconds → \"Xh Ym\" */\nexport function fmtDuration(seconds: number): string {\n  const h = Math.floor(seconds / 3600)\n  const m = Math.floor((seconds % 3600) / 60)\n  if (h > 0 && m > 0) return `${h}h ${m}m`\n  if (h > 0) return `${h}h`\n  if (m > 0) return `${m}m`\n  return `${seconds}s`\n}\n\n/** Shorten an Ethereum address */\nexport function fmtAddr(addr: string): string {\n  if (!addr || addr.length < 10) return addr\n  return `${addr.slice(0, 6)}...${addr.slice(-4)}`\n}\n\n/** Unix timestamp → locale date-time string */\nexport function fmtTime(ts: number): string {\n  if (!ts) return '-'\n  return new Date(ts * 1000).toLocaleString(undefined, {\n    month: 'short',\n    day: 'numeric',\n    hour: '2-digit',\n    minute: '2-digit',\n  })\n}\n\n/**\n * Map a contract custom error name (decoded from revert) to a user-facing message.\n */\nexport function mapContractError(message: string): string {\n  if (!message) return 'Transaction failed. Please try again.'\n  const m = message.toLowerCase()\n\n  // User rejection is not an error — handled upstream\n  if (m.includes('user rejected') || m.includes('user denied')) {\n    return 'Transaction cancelled.'\n  }\n\n  // Custom errors from ShiftProof.sol\n  if (m.includes('notemployer'))       return 'Only the employer can do this.'\n  if (m.includes('notworker'))         return 'Only the worker can do this.'\n  if (m.includes('invalidstatus'))     return 'This action is not allowed in the current shift status.'\n  if (m.includes('zerorate'))          return 'Hourly rate must be greater than zero.'\n  if (m.includes('rateoob'))           return 'Hourly rate exceeds the maximum allowed.'\n  if (m.includes('durationoob'))       return 'Max shift duration exceeds the allowed limit.'\n  if (m.includes('zeromaxseconds'))    return 'Max shift duration must be greater than zero.'\n  if (m.includes('zeroescrow'))        return 'Escrow amount would be zero — rate or duration is too small.'\n  if (m.includes('exceeds'))           return 'Total escrow would exceed the global cap.'\n  if (m.includes('approvefirst'))      return 'You must approve USDC spending first.'\n  if (m.includes('nothingtoclaim'))    return 'Nothing to claim — attested hours were zero.'\n  if (m.includes('transferfailed'))    return 'USDC transfer failed. Check your balance and allowance.'\n  if (m.includes('insufficient'))      return 'Insufficient USDC balance.'\n  if (m.includes('allowance'))         return 'USDC allowance too low. Please approve first.'\n  if (m.includes('reverted'))          return 'Transaction reverted. Please check your inputs.'\n  if (m.includes('timeout'))           return 'Network timeout. Please retry.'\n  if (m.includes('network'))           return 'Network error. Please check your connection.'\n\n  return 'Transaction failed. Please try again.'\n}\n","totalLines":80}}
