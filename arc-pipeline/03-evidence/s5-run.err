{"kind":"data","event":{"type":"file_write_streaming","toolCallId":"01a17b4c-716f-74eb-8491-2761f967e4bb","path":"/home/user/app/src/lib/format.ts","status":"running","chunk":"import { formatUnits } from 'viem'\n\n/** USDC has 6 decimals */\nexport function formatUsdc(raw: bigint): string {\n  return Number(formatUnits(raw, 6)).toLocaleString('en-US', {\n    minimumFractionDigits: 2,\n    maximumFractionDigits: 2,\n  })\n}\n\n/** Parse a string like \"12.50\" to 6-decimal bigint. Returns null if invalid. */\nexport function parseUsdc(s: string): bigint | null {\n  const n = parseFloat(s)\n  if (!isFinite(n) || n < 0) return null\n  // Use integer arithmetic to avoid float precision issues\n  const cents = Math.round(n * 1_000_000)\n  return BigInt(cents)\n}\n\n/** Shorten an address for display */\nexport function shortAddr(addr: string): string {\n  return `${addr.slice(0, 6)}…${addr.slice(-4)}`\n}\n\n/** Format seconds as \"Xh Ym\" */\nexport function formatSeconds(s: number): string {\n  if (s < 60) return `${s}s`\n  const h = Math.floor(s / 3600)\n  const m = Math.floor((s % 3600) / 60)\n  if (h === 0) return `${m}m`\n  if (m === 0) return `${h}h`\n  return `${h}h ${m}m`\n}\n\n/** Format a unix timestamp as a local date/time string */\nexport function formatTs(ts: number): string {\n  if (ts === 0) return '—'\n  return new Date(ts * 1000).toLocaleString('en-US', {\n    month: 'short', day: 'numeric', year: 'numeric',\n    hour: '2-digit', minute: '2-digit',\n  })\n}\n\n/**\n * Decode a known ShiftProof custom error from a raw viem error message.\n * Returns a user-friendly string or falls back gracefully.\n */\nexport function decodeContractError(err: unknown): string {\n  if (!err) return 'Unknown error'\n  const msg = (err as Error)?.message ?? String(err)\n  const lower = msg.toLowerCase()\n\n  if (lower.includes('user rejected') || lower.includes('user denied') || lower.includes('4001')) {\n    return 'Cancelled by wallet.'\n  }\n  if (msg.includes('NotWorker'))             return 'Only the assigned worker can do this.'\n  if (msg.includes('NotEmployer'))           return 'Only the employer can do this.'\n  if (msg.includes('WrongStatus'))           return 'The shift is not in the required state for this action.'\n  if (msg.includes('ZeroAddress'))           return 'Worker address cannot be zero.'\n  if (msg.includes('RateTooHigh'))           return 'Hourly rate exceeds the maximum allowed (10,000 USDC/h).'\n  if (msg.includes('DurationTooLong'))       return 'Shift duration exceeds the maximum allowed (24 h).'\n  if (msg.includes('EscrowTooLarge'))        return 'Total escrow would exceed the contract limit.'\n  if (msg.includes('SecondsTooLarge'))       return 'Attested seconds exceed the shift max duration.'\n  if (msg.includes('NothingToClaim'))        return 'Nothing to claim — attested seconds were zero.'\n  if (msg.includes('TransferFailed') || lower.includes('erc20') || lower.includes('transfer')) {\n    return 'USDC transfer failed — check your balance and approval.'\n  }\n  if (lower.includes('insufficient funds'))  return 'Insufficient USDC balance.'\n  if (lower.includes('reverted'))            return 'Transaction reverted — check conditions and retry.'\n  if (lower.includes('network') || lower.includes('timeout')) return 'Network error — retry.'\n\n  return 'Transaction failed.'\n}\n","totalLines":74}}
