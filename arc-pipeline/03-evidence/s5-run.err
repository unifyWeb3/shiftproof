{"kind":"data","event":{"type":"sandbox_step","step":"file_written","status":"running","path":"/home/user/app/src/lib/format.ts","toolCallId":"01a17b48-ac84-71d9-9abf-ac04f670f9d3"}}
{"kind":"data","event":{"type":"file_write_streaming","toolCallId":"01a17b48-ac84-71d9-9abf-ac04f670f9d3","path":"/home/user/app/src/lib/format.ts","status":"running","chunk":"/**\n * Formatting and error-decoding helpers.\n * All USDC amounts use 6 decimals. Never use 18-decimal native units for shift amounts.\n */\nimport { formatUnits, parseUnits, BaseError, ContractFunctionRevertedError } from 'viem'\n\nexport const USDC_DECIMALS = 6\n\n/** Parse a human-readable USDC string (e.g. \"5.0\") → raw bigint (6 dec) */\nexport function parseUsdc(value: string): bigint {\n  return parseUnits(value.trim(), USDC_DECIMALS)\n}\n\n/** Format raw USDC bigint → human string with up to 6 decimals, trailing zeros trimmed */\nexport function formatUsdc(raw: bigint, maxDecimals = 6): string {\n  const s = formatUnits(raw, USDC_DECIMALS)\n  const [int, dec = ''] = s.split('.')\n  const trimmed = dec.slice(0, maxDecimals).replace(/0+$/, '')\n  return trimmed ? `${int}.${trimmed}` : int\n}\n\n/** Format to exactly 2 decimal places for display */\nexport function formatUsdc2(raw: bigint): string {\n  return Number(formatUnits(raw, USDC_DECIMALS)).toLocaleString('en-US', {\n    minimumFractionDigits: 2,\n    maximumFractionDigits: 2,\n  })\n}\n\n/** Hours input → seconds (Math.round) */\nexport function hoursToSeconds(hours: number): number {\n  return Math.round(hours * 3600)\n}\n\n/** Seconds → \"Xh Ym\" display */\nexport function secondsToDisplay(secs: number): string {\n  if (secs === 0) return '0s'\n  const h = Math.floor(secs / 3600)\n  const m = Math.floor((secs % 3600) / 60)\n  const s = secs % 60\n  const parts: string[] = []\n  if (h) parts.push(`${h}h`)\n  if (m) parts.push(`${m}m`)\n  if (s) parts.push(`${s}s`)\n  return parts.join(' ')\n}\n\n/** Unix timestamp (seconds) → UTC + local display */\nexport function formatTimestamp(ts: number): string {\n  if (!ts) return '--'\n  const d = new Date(ts * 1000)\n  const utc = d.toUTCString().replace('GMT', 'UTC')\n  const local = d.toLocaleString()\n  return `${utc} (local: ${local})`\n}\n\nexport function shortTimestamp(ts: number): string {\n  if (!ts) return '--'\n  return new Date(ts * 1000).toUTCString().replace(' GMT', ' UTC')\n}\n\n/** Shorten an address */\nexport function shortAddr(addr: string): string {\n  if (!addr || addr.length < 10) return addr\n  return `${addr.slice(0, 6)}…${addr.slice(-4)}`\n}\n\n/** Compute escrow: floor(hourlyRate * maxSeconds / 3600) */\nexport function computeEscrow(hourlyRateRaw: bigint, maxSeconds: number): bigint {\n  return (hourlyRateRaw * BigInt(maxSeconds)) / 3600n\n}\n\n/** Compute owed: floor(hourlyRate * attestedSeconds / 3600) */\nexport function computeOwed(hourlyRateRaw: bigint, attestedSeconds: number): bigint {\n  return (hourlyRateRaw * BigInt(attestedSeconds)) / 3600n\n}\n\n// ---------------------------------------------------------------------------\n// Error decoding\n// ---------------------------------------------------------------------------\n\nconst ERROR_MAP: Record<string, string> = {\n  NotEmployer:      'Only the employer wallet can do this.',\n  NotWorker:        'Connect the worker wallet assigned to this shift.',\n  InvalidStatus:    \"This action isn't available at this stage.\",\n  AttestedTooLong:  'Attested hours exceed the shift maximum.',\n  NothingToClaim:   'No pay is due on this shift.',\n  NothingToRefund:  'No unused funds remain.',\n  InvalidAmount:    'Check the rate and hours; the budget is outside the allowed range.',\n  InvalidDuration:  'Check the rate and hours; the budget is outside the allowed range.',\n  EscrowTooLarge:   'Check the rate and hours; the budget is outside the allowed range.',\n  DurationTooLong:  'Check the rate and hours; the budget is outside the allowed range.',\n  InvalidDecimals:  'The token is not Arc USDC (6 decimals).',\n  ZeroAddress:      'Worker address cannot be zero.',\n  InvalidWorker:    'Worker address must differ from your address and be non-zero.',\n  TooManyIds:       'Provide at most 50 shift IDs at a time.',\n}\n\nexport function decodeContractError(err: unknown): string {\n  if (!err) return 'Unknown error.'\n\n  const msg = (err as { message?: string }).message ?? String(err)\n\n  // User rejection\n  if (\n    msg.toLowerCase().includes('user rejected') ||\n    msg.toLowerCase().includes('user denied') ||\n    (err as { code?: number }).code === 4001\n  ) {\n    return 'Transaction cancelled in your wallet.'\n  }\n\n  // Insufficient gas / funds\n  if (\n    msg.toLowerCase().includes('insufficient funds') ||\n    msg.toLowerCase().includes('exceeds balance') ||\n    msg.toLowerCase().includes('insufficient gas')\n  ) {\n    return 'Add USDC for gas; Arc transactions need at least 20 Gwei and enough balance for the fee.'\n  }\n\n  // USDC / blocklist transfer failure\n  if (\n    msg.toLowerCase().includes('blocklist') ||\n    msg.toLowerCase().includes('transfer failed') ||\n    msg.toLowerCase().includes('transferfailed')\n  ) {\n    return 'USDC transfer failed. The address may be blocked, or the balance is insufficient.'\n  }\n\n  // Viem ContractFunctionRevertedError — try to decode custom error name\n  if (err instanceof BaseError) {\n    const revertErr = err.walk((e) => e instanceof ContractFunctionRevertedError) as ContractFunctionRevertedError | null\n    if (revertErr) {\n      const name = revertErr.data?.errorName ?? ''\n      if (name && ERROR_MAP[name]) return ERROR_MAP[name]\n      if (name) return `Contract error: ${name}`\n    }\n    // Try to extract from raw message\n    for (const [key, val] of Object.entries(ERROR_MAP)) {\n      if (msg.includes(key)) return val\n    }\n    return err.shortMessage ?? msg\n  }\n\n  // Plain string matching\n  for (const [key, val] of Object.entries(ERROR_MAP)) {\n    if (msg.includes(key)) return val\n  }\n\n  return msg.length > 200 ? msg.slice(0, 200) + '…' : msg\n}\n","totalLines":153}}
