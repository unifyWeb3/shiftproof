{"kind":"data","event":{"type":"sandbox_step","step":"file_written","status":"running","path":"/home/user/app/src/lib/storage.ts","toolCallId":"01a17b4c-863d-70c2-b6aa-5ae219db3dcb"}}
{"kind":"data","event":{"type":"file_write_streaming","toolCallId":"01a17b4c-863d-70c2-b6aa-5ae219db3dcb","path":"/home/user/app/src/lib/storage.ts","status":"running","chunk":"/**\n * localStorage cache for shift IDs — keyed by role + connected wallet.\n * No PII stored. Values are just shift IDs (numbers).\n */\n\nconst KEY_EMPLOYER = 'sp:employer_shifts'\nconst KEY_WORKER   = 'sp:worker_shifts'\n\nfunction safeGet(key: string): number[] {\n  try {\n    const raw = localStorage.getItem(key)\n    if (!raw) return []\n    const parsed = JSON.parse(raw)\n    if (!Array.isArray(parsed)) return []\n    return parsed.filter((v): v is number => typeof v === 'number')\n  } catch {\n    return []\n  }\n}\n\nfunction safeSet(key: string, ids: number[]): void {\n  try {\n    localStorage.setItem(key, JSON.stringify(ids))\n  } catch {\n    // quota exceeded — silently ignore\n  }\n}\n\nfunction scopedKey(base: string, address: string): string {\n  return `${base}:${address.toLowerCase()}`\n}\n\nexport function addEmployerShift(address: string, id: number): void {\n  const key = scopedKey(KEY_EMPLOYER, address)\n  const existing = safeGet(key)\n  if (!existing.includes(id)) safeSet(key, [id, ...existing].slice(0, 50))\n}\n\nexport function addWorkerShift(address: string, id: number): void {\n  const key = scopedKey(KEY_WORKER, address)\n  const existing = safeGet(key)\n  if (!existing.includes(id)) safeSet(key, [id, ...existing].slice(0, 50))\n}\n\nexport function getEmployerShifts(address: string): number[] {\n  return safeGet(scopedKey(KEY_EMPLOYER, address))\n}\n\nexport function getWorkerShifts(address: string): number[] {\n  return safeGet(scopedKey(KEY_WORKER, address))\n}\n\nexport function removeShift(address: string, id: number): void {\n  const ek = scopedKey(KEY_EMPLOYER, address)\n  const wk = scopedKey(KEY_WORKER, address)\n  safeSet(ek, safeGet(ek).filter(v => v !== id))\n  safeSet(wk, safeGet(wk).filter(v => v !== id))\n}\n","totalLines":59}}
