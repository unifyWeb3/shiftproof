{"kind":"data","event":{"type":"sandbox_step","step":"file_written","status":"running","path":"/home/user/app/src/pages/ShiftReceipt.tsx","toolCallId":"01a17b4b-a5d0-7309-ba2b-da38939ec4d4"}}
{"kind":"data","event":{"type":"file_write_streaming","toolCallId":"01a17b4b-a5d0-7309-ba2b-da38939ec4d4","path":"/home/user/app/src/pages/ShiftReceipt.tsx","status":"running","chunk":"/**\n * /shift/:id — public receipt, read-only, no wallet required.\n */\nimport { useEffect } from 'react'\nimport { useReadContract } from 'wagmi'\nimport { ExternalLink, RefreshCw } from 'lucide-react'\nimport {\n  ABI, CONTRACT_ADDRESS, USDC_ADDRESS, CHAIN_ID, DEPLOYMENT_BLOCK,\n  explorerTx, explorerAddr,\n} from '../lib/contract'\nimport {\n  formatUsdc2, formatUsdc, secondsToDisplay, formatTimestamp, shortAddr,\n} from '../lib/format'\nimport { getTxHashes } from '../lib/storage'\nimport StatusBadge from '../components/StatusBadge'\nimport TxButton from '../components/TxButton'\nimport { useAccount } from 'wagmi'\nimport { useWrongChain } from '../components/NetworkGuard'\nimport NetworkGuard from '../components/NetworkGuard'\n\ninterface ShiftReceiptProps {\n  shiftId: string\n  navigate: (p: string) => void\n}\n\nexport default function ShiftReceipt({ shiftId, navigate }: ShiftReceiptProps) {\n  const numId = parseInt(shiftId)\n\n  const { data: shift, isLoading, refetch } = useReadContract({\n    address: CONTRACT_ADDRESS,\n    abi: ABI,\n    functionName: 'getShift',\n    args: [BigInt(numId || 0)],\n    chainId: CHAIN_ID,\n    query: { enabled: !isNaN(numId) && numId > 0 },\n  })\n\n  const { address } = useAccount()\n  const wrongChain = useWrongChain()\n\n  const txHashes = getTxHashes(shiftId)\n\n  const status    = shift ? Number(shift.status) : -1\n  const escrow    = shift ? (shift.escrow    as bigint) : 0n\n  const owed      = shift ? (shift.owed      as bigint) : 0n\n  const hourlyRate = shift ? (shift.hourlyRate as bigint) : 0n\n  const maxSecs   = shift ? Number(shift.maxSeconds)    : 0\n  const attestSecs = shift ? Number(shift.attestedSeconds) : 0\n  const createdAt  = shift ? Number(shift.createdAt) : 0\n  const startedAt  = shift ? Number(shift.startedAt) : 0\n  const endedAt    = shift ? Number(shift.endedAt)   : 0\n  const employer   = shift ? (shift.employer as string) : ''\n  const worker     = shift ? (shift.worker   as string) : ''\n\n  const isEmployer = address && employer && address.toLowerCase() === employer.toLowerCase()\n  const isWorker   = address && worker   && address.toLowerCase() === worker.toLowerCase()\n\n  const canRefund = (status === 4 || status === 5) && escrow > owed\n\n  useEffect(() => {\n    document.title = `Shift #${shiftId} — ShiftProof`\n    return () => { document.title = 'ShiftProof — Arc Testnet' }\n  }, [shiftId])\n\n  if (isNaN(numId) || numId <= 0) {\n    return (\n      <div className=\"max-w-2xl mx-auto\">\n        <p className=\"text-sm\" style={{ color: 'var(--danger)' }}>Invalid shift ID.</p>\n        <button onClick={() => navigate('/')} className=\"mt-2 text-sm hover:underline\" style={{ color: 'var(--accent-hover)' }}>Back to home</button>\n      </div>\n    )\n  }\n\n  return (\n    <div className=\"max-w-2xl mx-auto space-y-6\">\n      <div className=\"flex items-center justify-between\">\n        <div>\n          <h1 className=\"display text-2xl font-bold\" style={{ color: 'var(--ink)', letterSpacing: '-0.02em' }}>\n            Shift #{shiftId}\n          </h1>\n          <p className=\"text-xs mt-0.5\" style={{ color: 'var(--subtle)' }}>Public receipt — no wallet required to view</p>\n        </div>\n        <button onClick={() => refetch()} className=\"p-2 rounded-lg hover:bg-slate-100\">\n          <RefreshCw className=\"size-4\" style={{ color: 'var(--subtle)' }} />\n        </button>\n      </div>\n\n      {isLoading && (\n        <div className=\"rounded-2xl p-6 animate-pulse\" style={{ background: 'var(--surface-muted)', border: '1px solid var(--border)' }}>\n          <div className=\"h-4 w-32 rounded bg-slate-200 mb-3\" />\n          <div className=\"h-3 w-48 rounded bg-slate-200\" />\n        </div>\n      )}\n\n      {!isLoading && (!shift || status === 0) && (\n        <div className=\"rounded-2xl p-6\" style={{ background: 'var(--surface-muted)', border: '1px solid var(--border)' }}>\n          <p className=\"text-sm\" style={{ color: 'var(--muted)' }}>Shift #{shiftId} not found on-chain.</p>\n          <p className=\"text-xs mt-1\" style={{ color: 'var(--subtle)' }}>\n            Deployment block: {DEPLOYMENT_BLOCK.toString()} — only shifts created after this block exist.\n          </p>\n        </div>\n      )}\n\n      {!isLoading && shift && status > 0 && (\n        <>\n          {/* Status card */}\n          <div\n            className=\"rounded-2xl p-5\"\n            style={{ background: 'var(--surface-strong)', border: '1px solid var(--border)' }}\n          >\n            <div className=\"flex items-center justify-between mb-4\">\n              <StatusBadge status={status} />\n              <a\n                href={explorerAddr(CONTRACT_ADDRESS)}\n                target=\"_blank\"\n                rel=\"noopener noreferrer\"\n                className=\"text-xs flex items-center gap-1 hover:underline\"\n                style={{ color: 'var(--accent-hover)' }}\n              >\n                Verify onchain <ExternalLink className=\"size-3\" />\n              </a>\n            </div>\n\n            <div className=\"grid sm:grid-cols-2 gap-x-6 gap-y-3 text-sm\">\n              <Field label=\"Shift ID\" value={`#${shiftId}`} />\n              <Field label=\"Status\" value={['None','Funded','Active','Awaiting Attestation','Attested','Claimed','Settled','Cancelled'][status]} />\n              <Field label=\"Employer\" value={<AddrLink addr={employer} />} />\n              <Field label=\"Worker\"   value={<AddrLink addr={worker}   />} />\n              <Field label=\"Hourly rate\" value={<span className=\"tabular-nums\">{formatUsdc(hourlyRate, 6)} USDC/hr</span>} />\n              <Field label=\"Max duration\" value={secondsToDisplay(maxSecs)} />\n              <Field label=\"Attested\" value={`${secondsToDisplay(attestSecs)} (${attestSecs}s)`} />\n              <Field label=\"Escrow remaining\" value={<span className=\"tabular-nums\">{formatUsdc2(escrow)} USDC</span>} />\n              <Field label=\"Owed to worker\" value={<span className=\"tabular-nums\" style={{ color: owed > 0n ? 'var(--success)' : undefined }}>{formatUsdc2(owed)} USDC</span>} />\n            </div>\n          </div>\n\n          {/* Timestamps */}\n          <div className=\"rounded-2xl p-5\" style={{ background: 'var(--surface-strong)', border: '1px solid var(--border)' }}>\n            <h2 className=\"font-semibold text-sm mb-3\" style={{ color: 'var(--ink)' }}>Timestamps (UTC)</h2>\n            <div className=\"space-y-2 text-sm\">\n              <Field label=\"Created\" value={formatTimestamp(createdAt)} />\n              {startedAt > 0 && <Field label=\"Clocked in\" value={formatTimestamp(startedAt)} />}\n              {endedAt   > 0 && <Field label=\"Clocked out\" value={formatTimestamp(endedAt)} />}\n            </div>\n          </div>\n\n          {/* Transaction hashes */}\n          {Object.keys(txHashes).length > 0 && (\n            <div className=\"rounded-2xl p-5\" style={{ background: 'var(--surface-strong)', border: '1px solid var(--border)' }}>\n              <h2 className=\"font-semibold text-sm mb-3\" style={{ color: 'var(--ink)' }}>Transaction hashes (local cache)</h2>\n              <div className=\"space-y-2 text-sm\">\n                {Object.entries(txHashes).map(([step, hash]) => (\n                  <div key={step} className=\"flex items-center justify-between gap-2\">\n                    <span className=\"capitalize\" style={{ color: 'var(--muted)' }}>{step}</span>\n                    <a\n                      href={explorerTx(hash as string)}\n                      target=\"_blank\"\n                      rel=\"noopener noreferrer\"\n                      className=\"mono text-xs flex items-center gap-1 hover:underline\"\n                      style={{ color: 'var(--accent-hover)' }}\n                    >\n                      {shortAddr(hash as string)} <ExternalLink className=\"size-3\" />\n                    </a>\n                  </div>\n                ))}\n              </div>\n            </div>\n          )}\n\n          {/* Contract links */}\n          <div className=\"rounded-2xl p-5 space-y-2 text-sm\" style={{ background: 'var(--surface-strong)', border: '1px solid var(--border)' }}>\n            <h2 className=\"font-semibold mb-3\" style={{ color: 'var(--ink)' }}>Contract links</h2>\n            <LinkRow label=\"ShiftProof contract\" href={explorerAddr(CONTRACT_ADDRESS)} value={CONTRACT_ADDRESS} />\n            <LinkRow label=\"USDC token\" href={explorerAddr(USDC_ADDRESS)} value={USDC_ADDRESS} />\n          </div>\n\n          {/* Actions (if applicable) */}\n          {canRefund && (\n            <NetworkGuard>\n              <section className=\"rounded-2xl p-5\" style={{ background: 'var(--surface-strong)', border: '1px solid var(--border)' }}>\n                <h2 className=\"font-semibold text-sm mb-3\" style={{ color: 'var(--ink)' }}>Permissionless action</h2>\n                <p className=\"text-xs mb-3\" style={{ color: 'var(--muted)' }}>\n                  Anyone can call refundUnused to return the residual escrow to the employer. No wallet access required beyond gas.\n                </p>\n                <TxButton\n                  label={`Refund unused (${formatUsdc2(escrow - owed)} USDC to employer)`}\n                  address={CONTRACT_ADDRESS}\n                  abi={ABI}\n                  functionName=\"refundUnused\"\n                  args={[BigInt(shiftId)]}\n                  confirmCard={\n                    <div className=\"space-y-2 text-sm\">\n                      <Field label=\"Shift ID\" value={`#${shiftId}`} />\n                      <Field label=\"Refund amount\" value={<span className=\"tabular-nums\">{formatUsdc2(escrow - owed)} USDC</span>} />\n                      <Field label=\"Always goes to\" value=\"Employer\" />\n                    </div>\n                  }\n                  onSuccess={() => refetch()}\n                />\n              </section>\n            </NetworkGuard>\n          )}\n\n          {/* Role hints */}\n          {isEmployer && [1,2,3].includes(status) && (\n            <div className=\"rounded-xl p-3 text-xs\" style={{ background: '#eff6ff', border: '1px solid #bfdbfe', color: '#1e40af' }}>\n              You are the employer. Go to the{' '}\n              <button className=\"underline\" onClick={() => navigate('/employer')}>Employer Dashboard</button>{' '}\n              to attest hours or cancel.\n            </div>\n          )}\n          {isWorker && [1,2,3].includes(status) && (\n            <div className=\"rounded-xl p-3 text-xs\" style={{ background: '#f0fdf4', border: '1px solid #86efac', color: '#166534' }}>\n              You are the worker. Go to the{' '}\n              <button className=\"underline\" onClick={() => navigate('/worker')}>Worker Dashboard</button>{' '}\n              to clock in/out or claim.\n            </div>\n          )}\n        </>\n      )}\n\n      <button\n        onClick={() => navigate('/')}\n        className=\"text-sm hover:underline\"\n        style={{ color: 'var(--subtle)' }}\n      >\n        Back to home\n      </button>\n    </div>\n  )\n}\n\nfunction Field({ label, value }: { label: string; value: React.ReactNode }) {\n  return (\n    <div className=\"flex items-start justify-between gap-4\">\n      <span className=\"shrink-0\" style={{ color: 'var(--muted)' }}>{label}</span>\n      <span className=\"text-right font-medium\" style={{ color: 'var(--ink)' }}>{value}</span>\n    </div>\n  )\n}\n\nfunction AddrLink({ addr }: { addr: string }) {\n  return (\n    <a href={explorerAddr(addr)} target=\"_blank\" rel=\"noopener noreferrer\" className=\"mono hover:underline flex items-center gap-0.5\" style={{ color: 'var(--accent-hover)' }}>\n      {shortAddr(addr)} <ExternalLink className=\"size-3\" />\n    </a>\n  )\n}\n\nfunction LinkRow({ label, href, value }: { label: string; href: string; value: string }) {\n  return (\n    <div className=\"flex items-start justify-between gap-4\">\n      <span style={{ color: 'var(--muted)' }}>{label}</span>\n      <a href={href} target=\"_blank\" rel=\"noopener noreferrer\" className=\"mono text-xs flex items-center gap-1 hover:underline\" style={{ color: 'var(--accent-hover)' }}>\n        {shortAddr(value)} <ExternalLink className=\"size-3\" />\n      </a>\n    </div>\n  )\n}\n","totalLines":260}}
