{"kind":"data","event":{"type":"tool_call","status":"complete","toolCallId":"01a17b56-268d-7784-94d2-74bfc0f5dfd0","toolName":"read_file","args":{"file_path":"/home/user/app/src/lib/contract.ts","limit":60},"result":"{\"lc\":1,\"type\":\"constructor\",\"id\":[\"langchain_core\",\"messages\",\"ToolMessage\"],\"kwargs\":{\"status\":\"success\",\"content\":[{\"type\":\"text\",\"text\":\"     1\\t/**\\n     2\\t * Contract facts — loaded from deployments.json (single source of truth)\\n     3\\t * and ABI from the compiled artifact.\\n     4\\t */\\n     5\\timport deployments from '../../deployments.json'\\n     6\\timport artifact from '../../contracts/out/ShiftProof.sol/ShiftProof.json'\\n     7\\t\\n     8\\texport const ABI = artifact.abi\\n     9\\t\\n    10\\texport const CHAIN_ID = deployments.ShiftProof.arcTestnet.chainId         // 5042002\\n    11\\texport const CONTRACT_ADDRESS = deployments.ShiftProof.arcTestnet.address as `0x${string}`\\n    12\\texport const USDC_ADDRESS     = deployments.ShiftProof.arcTestnet.usdc as `0x${string}`\\n    13\\texport const DEPLOYMENT_BLOCK = BigInt(deployments.ShiftProof.arcTestnet.deploymentBlock)\\n    14\\texport const DEPLOYMENT_TX    = deployments.ShiftProof.arcTestnet.txHash\\n    15\\texport const EXPLORER_BASE    = 'https://explorer.testnet.arc.io'\\n    16\\t\\n    17\\texport const explorerTx   = (hash: string) => `${EXPLORER_BASE}/tx/${hash}`\\n    18\\texport const explorerAddr = (addr: string) => `${EXPLORER_BASE}/address/${addr}`\\n    19\\t\\n    20\\t// Status enum mirrors Solidity (index == value)\\n    21\\texport const STATUS_LABELS: Record<number, string> = {\\n    22\\t  0: 'None',\\n    23\\t  1: 'Funded',\\n    24\\t  2: 'Active',\\n    25\\t  3: 'Awaiting Attestation',\\n    26\\t  4: 'Attested',\\n    27\\t  5: 'Claimed',\\n    28\\t  6: 'Settled',\\n    29\\t  7: 'Cancelled',\\n    30\\t}\\n    31\\t\\n    32\\texport const STATUS_COLORS: Record<number, string> = {\\n    33\\t  0: '#8a849c',\\n    34\\t  1: '#1061a6',\\n    35\\t  2: '#1a8047',\\n    36\\t  3: '#d97706',\\n    37\\t  4: '#7c3aed',\\n    38\\t  5: '#0284c7',\\n    39\\t  6: '#1a8047',\\n    40\\t  7: '#ba2b4c',\\n    41\\t}\"}],\"tool_call_id\":\"toolu_bdrk_018ScFGUnuAWNwQ95aqMWQYD\",\"name\":\"read_file\",\"metadata\":{\"versions\":{\"@langchain/core\":\"1.2.18\"}},\"additional_kwargs\":{},\"response_metadata\":{}}}"}}
