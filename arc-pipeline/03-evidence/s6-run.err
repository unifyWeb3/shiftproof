{"kind":"data","event":{"type":"file_write_streaming","toolCallId":"01a17b56-70d5-7549-87db-f5200db7b7d9","path":"/home/user/app/src/index.css","status":"running","chunk":"@tailwind base;\n@tailwind components;\n@tailwind utilities;\n\n:root {\n  --bg: #ffffff;\n  --bg-gradient: linear-gradient(180deg, #f9f9fc 0%, #fffcf7 52%, #fbf7f2 100%);\n  --surface: rgba(255, 255, 255, 0.72);\n  --surface-strong: rgba(255, 255, 255, 0.90);\n  --surface-muted: #f5f5f8;\n  --ink: #122d45;\n  --ink-2: #334155;\n  --muted: #6b6580;\n  --subtle: #8a849c;\n  --border: rgba(18, 45, 69, 0.12);\n  --border-strong: rgba(25, 53, 77, 0.50);\n  --accent: #122d45;\n  --accent-hover: #1061a6;\n  --focus: #85b1ed;\n  --success: #1a8047;\n  --danger: #ba2b4c;\n  --warning-bg: #fefce8;\n  --warning-border: #fde047;\n}\n\n* {\n  box-sizing: border-box;\n}\n\nbody {\n  margin: 0;\n  /* System font stack — no remote fonts */\n  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;\n  min-height: 100dvh;\n  background: var(--bg-gradient);\n  color: var(--ink);\n}\n\n.display {\n  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;\n  letter-spacing: -0.02em;\n  font-weight: 700;\n}\n\n.mono {\n  font-family: 'Menlo', 'Cascadia Code', 'Consolas', ui-monospace, monospace;\n  font-size: 0.85em;\n}\n\n/* scrollbar */\n::-webkit-scrollbar { width: 4px; }\n::-webkit-scrollbar-track { background: transparent; }\n::-webkit-scrollbar-thumb { background: var(--border-strong); border-radius: 2px; }\n","totalLines":54}}
