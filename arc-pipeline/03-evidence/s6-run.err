{"kind":"data","event":{"type":"tool_call","status":"running","toolCallId":"01a17b56-3006-77d9-b13d-880ed2b2eb59","toolName":"read_file","args":{"file_path":"/home/user/app/src/lib/storage.ts","limit":60}}}
{"kind":"data","event":{"type":"tool_call","status":"complete","toolCallId":"01a17b56-3006-77d9-b13d-880ed2b2eb59","toolName":"read_file","args":{"file_path":"/home/user/app/src/lib/storage.ts","limit":60},"result":"{\"lc\":1,\"type\":\"constructor\",\"id\":[\"langchain_core\",\"messages\",\"ToolMessage\"],\"kwargs\":{\"status\":\"success\",\"content\":[{\"type\":\"text\",\"text\":\"     1\\t/**\\n     2\\t * localStorage cache for shift IDs — keyed by role + connected wallet.\\n     3\\t * No PII stored. Values are just shift IDs (numbers).\\n     4\\t */\\n     5\\t\\n     6\\tconst KEY_EMPLOYER = 'sp:employer_shifts'\\n     7\\tconst KEY_WORKER   = 'sp:worker_shifts'\\n     8\\t\\n     9\\tfunction safeGet(key: string): number[] {\\n    10\\t  try {\\n    11\\t    const raw = localStorage.getItem(key)\\n    12\\t    if (!raw) return []\\n    13\\t    const parsed: unknown = JSON.parse(raw)\\n    14\\t    if (!Array.isArray(parsed)) return []\\n    15\\t    return parsed.filter((v): v is number => typeof v === 'number')\\n    16\\t  } catch {\\n    17\\t    return []\\n    18\\t  }\\n    19\\t}\\n    20\\t\\n    21\\tfunction safeSet(key: string, ids: number[]): void {\\n    22\\t  try {\\n    23\\t    localStorage.setItem(key, JSON.stringify(ids))\\n    24\\t  } catch {\\n    25\\t    // quota exceeded — silently ignore\\n    26\\t  }\\n    27\\t}\\n    28\\t\\n    29\\tfunction scopedKey(base: string, address: string): string {\\n    30\\t  return `${base}:${address.toLowerCase()}`\\n    31\\t}\\n    32\\t\\n    33\\texport function addEmployerShift(address: string, id: number): void {\\n    34\\t  const key = scopedKey(KEY_EMPLOYER, address)\\n    35\\t  const existing = safeGet(key)\\n    36\\t  if (!existing.includes(id)) safeSet(key, [id, ...existing].slice(0, 50))\\n    37\\t}\\n    38\\t\\n    39\\texport function addWorkerShift(address: string, id: number): void {\\n    40\\t  const key = scopedKey(KEY_WORKER, address)\\n    41\\t  const existing = safeGet(key)\\n    42\\t  if (!existing.includes(id)) safeSet(key, [id, ...existing].slice(0, 50))\\n    43\\t}\\n    44\\t\\n    45\\texport function getEmployerShifts(address: string): number[] {\\n    46\\t  return safeGet(scopedKey(KEY_EMPLOYER, address))\\n    47\\t}\\n    48\\t\\n    49\\texport function getWorkerShifts(address: string): number[] {\\n    50\\t  return safeGet(scopedKey(KEY_WORKER, address))\\n    51\\t}\\n    52\\t\\n    53\\texport function removeShift(address: string, id: number): void {\\n    54\\t  const ek = scopedKey(KEY_EMPLOYER, address)\\n    55\\t  const wk = scopedKey(KEY_WORKER, address)\\n    56\\t  safeSet(ek, safeGet(ek).filter(v => v !== id))\\n    57\\t  safeSet(wk, safeGet(wk).filter(v => v !== id))\\n    58\\t}\"}],\"tool_call_id\":\"toolu_bdrk_018ZyvRC1tZsVSZA8AaDh2iM\",\"name\":\"read_file\",\"metadata\":{\"versions\":{\"@langchain/core\":\"1.2.18\"}},\"additional_kwargs\":{},\"response_metadata\":{}}}"}}
{"kind":"data","event":{"type":"tool_call","status":"complete","toolCallId":"01a17b56-3005-702c-86c9-f8bf0420de84","toolName":"read_file","args":{"file_path":"/home/user/app/src/lib/format.ts","limit":80},"result":"{\"lc\":1,\"type\":\"constructor\",\"id\":[\"langchain_core\",\"messages\",\"ToolMessage\"],\"kwargs\":{\"status\":\"success\",\"content\":[{\"type\":\"text\",\"text\":\"     1\\timport { formatUnits } from 'viem'\\n     2\\t\\n     3\\t// USDC on Arc Testnet has 6 decimals for the ERC-20 view\\n     4\\tconst USDC_DECIMALS = 6\\n     5\\t\\n     6\\texport function fmtUsdc(raw: bigint | undefined, decimals = 2): string {\\n     7\\t  if (raw === undefined) return '—'\\n     8\\t  const s = formatUnits(raw, USDC_DECIMALS)\\n     9\\t  return parseFloat(s).toFixed(decimals)\\n    10\\t}\\n    11\\t\\n    12\\texport function fmtUsdcFull(raw: bigint | undefined): string {\\n    13\\t  if (raw === undefined) return '—'\\n    14\\t  return parseFloat(formatUnits(raw, USDC_DECIMALS)).toLocaleString('en-US', {\\n    15\\t    minimumFractionDigits: 2,\\n    16\\t    maximumFractionDigits: 6,\\n    17\\t  })\\n    18\\t}\\n    19\\t\\n    20\\texport function fmtAddr(addr: string): string {\\n    21\\t  return `${addr.slice(0, 6)}...${addr.slice(-4)}`\\n    22\\t}\\n    23\\t\\n    24\\texport function fmtSeconds(s: number | bigint): string {\\n    25\\t  const n = Number(s)\\n    26\\t  if (n < 60) return `${n}s`\\n    27\\t  if (n < 3600) return `${Math.floor(n / 60)}m ${n % 60}s`\\n    28\\t  const h = Math.floor(n / 3600)\\n    29\\t  const m = Math.floor((n % 3600) / 60)\\n    30\\t  return m > 0 ? `${h}h ${m}m` : `${h}h`\\n    31\\t}\\n    32\\t\\n    33\\texport function fmtDate(ts: number | bigint): string {\\n    34\\t  if (!ts) return '—'\\n    35\\t  return new Date(Number(ts) * 1000).toLocaleString()\\n    36\\t}\\n    37\\t\\n    38\\t/** Parse a decimal USDC string into bigint raw units (6 decimals). */\\n    39\\texport function parseUsdcInput(value: string): bigint {\\n    40\\t  const [whole = '0', frac = ''] = value.split('.')\\n    41\\t  const fracPadded = frac.padEnd(USDC_DECIMALS, '0').slice(0, USDC_DECIMALS)\\n    42\\t  return BigInt(whole) * BigInt(10 ** USDC_DECIMALS) + BigInt(fracPadded)\\n    43\\t}\\n    44\\t\\n    45\\t/** Custom error selector -> friendly message */\\n    46\\tconst ERROR_MAP: Record<string, string> = {\\n    47\\t  '0x0d7ee7a7': 'Wrong caller for this action.',\\n    48\\t  '0xb8ed89d2': 'This shift ID does not exist.',\\n    49\\t  '0x3b3cef0a': 'Action not allowed in current shift status.',\\n    50\\t  '0x2a12a64e': 'Hourly rate exceeds the maximum allowed.',\\n    51\\t  '0x13be252b': 'Shift duration exceeds the maximum allowed.',\\n    52\\t  '0xc2f4d75a': 'USDC transfer failed.',\\n    53\\t  '0x47f6d4bf': 'Nothing to claim on this shift.',\\n    54\\t  '0x9c8d2cd2': 'Attested seconds exceed shift duration.',\\n    55\\t  '0x3c23e1b0': 'Worker address is invalid.',\\n    56\\t  '0x2b7a1e5d': 'Hourly rate must be greater than zero.',\\n    57\\t}\\n    58\\t\\n    59\\texport function decodeContractError(err: unknown): string {\\n    60\\t  const msg = (err as { message?: string })?.message ?? String(err)\\n    61\\t  // look for a 4-byte selector in the error data\\n    62\\t  const selectorMatch = msg.match(/0x[0-9a-fA-F]{8}/)\\n    63\\t  if (selectorMatch) {\\n    64\\t    const hit = ERROR_MAP[selectorMatch[0].toLowerCase()]\\n    65\\t    if (hit) return hit\\n    66\\t  }\\n    67\\t  // user rejected\\n    68\\t  if (msg.toLowerCase().includes('user rejected') || msg.includes('4001')) {\\n    69\\t    return 'Transaction cancelled.'\\n    70\\t  }\\n    71\\t  // revert reason string\\n    72\\t  const revertMatch = msg.match(/reason[^:]*:\\\\s*\\\"?([^\\\"]+)\\\"?/i)\\n    73\\t  if (revertMatch) return revertMatch[1]\\n    74\\t  // execution reverted generic\\n    75\\t  if (msg.toLowerCase().includes('reverted')) return 'Transaction reverted. Check inputs and try again.'\\n    76\\t  return 'Something went wrong. Please try again.'\\n    77\\t}\"}],\"tool_call_id\":\"toolu_bdrk_01K9wkEi1VeobUYFxGw7EfkT\",\"name\":\"read_file\",\"metadata\":{\"versions\":{\"@langchain/core\":\"1.2.18\"}},\"additional_kwargs\":{},\"response_metadata\":{}}}"}}
