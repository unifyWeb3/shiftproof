{"kind":"data","event":{"type":"sandbox_command","toolCallId":"01a17b56-1847-75f0-be64-ee096484b649","command":"[redacted]","status":"complete","output":"  MAX_ESCROW() -> [('', 'uint256')]\n  MAX_HOURLY_RATE() -> [('', 'uint256')]\n  MAX_SHIFT_SECONDS() -> [('', 'uint32')]\n  attest(uint256, uint32) -> []\n  cancel(uint256) -> []\n  claim(uint256) -> []\n  clockIn(uint256) -> []\n  clockOut(uint256) -> []\n  createShift(address, uint256, uint32) -> [('shiftId', 'uint256')]\n  getShift(uint256) -> [('', 'tuple')]\n  getShifts(uint256[]) -> [('', 'tuple[]')]\n  nextShiftId() -> [('', 'uint256')]\n  refundUnused(uint256) -> []\n  totalEscrow() -> [('', 'uint256')]\n  usdc() -> [('', 'address')]\n  EVENT Attested([('shiftId', 'uint256', True), ('employer', 'address', True), ('attestedSeconds', 'uint32', False), ('owed', 'uint256', False)])\n  EVENT Cancelled([('shiftId', 'uint256', True), ('employer', 'address', True), ('amount', 'uint256', False)])\n  EVENT Claimed([('shiftId', 'uint256', True), ('worker', 'address', True), ('amount', 'uint256', False)])\n  EVENT ClockedIn([('shiftId', 'uint256', True), ('worker', 'address', True), ('at', 'uint64', False)])\n  EVENT ClockedOut([('shiftId', 'uint256', True), ('worker', 'address', True), ('at', 'uint64', False)])\n  EVENT Settled([('shiftId', 'uint256', True)])\n  EVENT ShiftCreated([('shiftId', 'uint256', True), ('employer', 'address', True), ('worker', 'address', True), ('escrow', 'uint256', False), ('hourlyRate', 'uint256', False), ('maxSeconds', 'uint32', False)])\n  EVENT UnusedRefunded([('shiftId', 'uint256', True), ('employer', 'address', True), ('amount', 'uint256', False)])\n  ERROR AttestedTooLong([])\n  ERROR DurationTooLong([])\n  ERROR EscrowTooLarge([])\n  ERROR InvalidAmount([])\n  ERROR InvalidDecimals([])\n  ERROR InvalidDuration([])\n  ERROR InvalidStatus([])\n  ERROR InvalidWorker([])\n  ERROR NotEmployer([])\n  ERROR NotWorker([])\n  ERROR NothingToClaim([])\n  ERROR NothingToRefund([])\n  ERROR Reen